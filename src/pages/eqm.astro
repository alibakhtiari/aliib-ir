---
import '../styles/eqm.css';
import { RECORD, ANATOMY_IMG, BREED_RANGE, ANOV_RANGE, REASONS, FOL_POS } from '../data/eqmSeed';
---

<!doctype html>
<html lang="fa" dir="rtl">

<head>
  <meta name="robots" content="noindex, nofollow">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
  <title>گزارش هوشمند مامایی</title>
  <link rel="preload" href="/IRANSansX-Regular.woff2" as="font" type="font/woff2" crossorigin>
</head>

<body>
  <div class="app">
    <header>
      <div class="head">
        <button class="back" onclick="history.back()">‹</button>
        <div class="title">
          <h1>گزارش هوشمند مامایی</h1>
          <p id="branchName">فرم تطبیقی سونوگرافی مادیان</p>
        </div>
      </div>
      <div class="progress"><span id="progressBar"></span></div>
    </header>

    <main id="main">
      <div id="step"></div>
    </main>

    <div class="nav" id="nav">
      <button class="prev" id="btnPrev" onclick="prev()">قبلی</button>
      <button class="reset" id="btnReset" onclick="resetForm()">بازنشانی</button>
      <button class="next" id="btnNext" onclick="next()">بعدی</button>
    </div>

    <div class="toast" id="toast"></div>
  </div>

  <script is:inline define:vars={{ RECORD, ANATOMY_IMG, BREED_RANGE, ANOV_RANGE, REASONS, FOL_POS }}>
    /* ================= state ================= */
    let currentReason = null;
    let bcs = null;
    let currentId = 'bcs';
    let sheetKey = null;
    let follicleSide = null;
    let anovOn = false;
    let curFollicle = false;
    let dominantManual = false;

    /* CL & Anovulatory & Uterus state */
    const anov = { right: false, left: false };
    const clState = {
      right: { observed: false, size: null },
      left: { observed: false, size: null }
    };

    const choices = {
      breedingMethod: RECORD.breedingMethod,
      fluidCycle: 'ندارد'
    };
    const multis = {};
    const fields = {
      lastScan: RECORD.lastScan,
      lastBreedingDate: RECORD.lastBreedingDate,
      pregBreedingDate: RECORD.lastBreedingDate,
      daysPostBreeding: RECORD.daysPostBreeding,
      prevMethod: RECORD.prevMethod,
      prevFollicleNote: RECORD.prevFollicleNote,
      problemHistory: RECORD.problemHistory,
      fluidEcho: ''
    };
    const sizes = {};
    const dates = {
      lastBreedingDate: RECORD.lastBreeding ? Object.assign({}, RECORD.lastBreeding) : null,
      pregBreedingDate: RECORD.lastBreeding ? Object.assign({}, RECORD.lastBreeding) : null
    };

    const ultrasoundImages = { cycle: [], ovulation: [], pregnancy: [], problem: [], other: [] };

    const fa = n => String(n).replace(/[0-9]/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);
    const p2 = n => fa(n < 10 ? '0' + n : String(n));

    /* ================= Jalali (Shamsi) calendar ================= */
    function g2j(gy, gm, gd) {
      var gdm = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
      var jy = gy <= 1600 ? 0 : 979; gy -= gy <= 1600 ? 621 : 1600;
      var gy2 = gm > 2 ? gy + 1 : gy;
      var days = 365 * gy + Math.floor((gy2 + 3) / 4) - Math.floor((gy2 + 99) / 100) + Math.floor((gy2 + 399) / 400) - 80 + gd + gdm[gm - 1];
      jy += 33 * Math.floor(days / 12053); days %= 12053;
      jy += 4 * Math.floor(days / 1461); days %= 1461;
      jy += Math.floor((days - 1) / 365);
      if (days > 365) days = (days - 1) % 365;
      var jm = days < 186 ? 1 + Math.floor(days / 31) : 7 + Math.floor((days - 186) / 30);
      var jd = 1 + (days < 186 ? days % 31 : (days - 186) % 30);
      return [jy, jm, jd];
    }
    function j2g(jy, jm, jd) {
      var gy = jy > 979 ? 1600 : 621; jy -= jy > 979 ? 979 : 0;
      var days = 365 * jy + Math.floor(jy / 33) * 8 + Math.floor(((jy % 33) + 3) / 4) + 78 + jd + (jm < 7 ? (jm - 1) * 31 : ((jm - 7) * 30) + 186);
      gy += 400 * Math.floor(days / 146097); days %= 146097;
      if (days > 36524) { gy += 100 * Math.floor(--days / 36524); days %= 36524; if (days >= 365) days++; }
      gy += 4 * Math.floor(days / 1461); days %= 1461;
      if (days > 365) { gy += Math.floor((days - 1) / 365); days = (days - 1) % 365; }
      var gd = days + 1;
      var sal = [0, 31, ((gy % 4 == 0 && gy % 100 != 0) || (gy % 400 == 0)) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
      var gm = 0; for (gm = 0; gm < 13; gm++) { var v = sal[gm]; if (gd <= v) break; gd -= v; }
      return [gy, gm, gd];
    }
    function isLeap(jy) {
      var a = j2g(jy, 1, 1), b = j2g(jy + 1, 1, 1);
      return (Date.UTC(b[0], b[1] - 1, b[2]) - Date.UTC(a[0], a[1] - 1, a[2])) / 86400000 === 366;
    }
    function monthLen(jy, jm) { return jm <= 6 ? 31 : jm <= 11 ? 30 : (isLeap(jy) ? 30 : 29); }
    function jWeekday(jy, jm, jd) { var g = j2g(jy, jm, jd); return (new Date(g[0], g[1] - 1, g[2]).getDay() + 1) % 7; }
    function fmtJ(jy, jm, jd) { return p2(jy) + '/' + p2(jm) + '/' + p2(jd); }

    const MONTHS = ['', 'فروردین', 'اردیبهشت', 'خرداد', 'تیر', 'مرداد', 'شهریور', 'مهر', 'آبان', 'آذر', 'دی', 'بهمن', 'اسفند'];
    const DOWS = ['ش', 'ی', 'د', 'س', 'چ', 'پ', 'ج'];

    const fpx = v => Math.min(52, Math.max(8, v * 1.05));

    /* ================= steps ================= */
    const bcsStep = {
      id: 'bcs', group: 'bcs', title: 'BCS مادیان', sub: 'امتیاز وضعیت بدنی را قبل از شروع ثبت کنید.', kind: 'choice',
      options: ['1', '2', '3', '4', '5', '6', '7', '8', '9', { label: 'ارزیابی نشد', cls: 'blue' }],
      legend: '۱ = بسیار لاغر &nbsp;•&nbsp; ۵ = متوسط &nbsp;•&nbsp; ۹ = بسیار چاق'
    };

    const breedStep = {
      id: 'breed', group: 'breed', title: 'نژاد / تیپ مادیان', sub: 'برای تعیین بازه طبیعی اندازه فولیکول استفاده می‌شود.',
      kind: 'choice',
      options: [
        'عرب / اصیل',
        'ترکمن / دوخون',
        'دره‌شوری / کُرد',
        'وارم‌بلاد (پرشی)',
        'تروبرد',
        'اسبچه خزر (پونی)',
        'نامشخص'
      ]
    };

    const reasonStep = {
      id: 'reason', group: 'reason', title: 'علت مراجعه چیست؟', sub: 'فقط سؤال‌های مرتبط با نوع ویزیت نمایش داده می‌شوند.',
      kind: 'choice', options: REASONS.map(r => r.label)
    };

    const BRANCH_STEPS = {
      cycle: [
        { id: 'cycleStage', group: 'cycleStage', title: 'وضعیت فعلی مادیان', sub: 'کدام فاز را مشاهده می‌کنید؟', kind: 'choice', options: ['فحل', 'دیستروس', 'آنستروس', 'نامشخص'] },
        { id: 'breedingDate', key: 'lastBreedingDate', title: 'تاریخ آخرین تلقیح / جفت‌گیری', sub: 'از پرونده خوانده شده؛ در صورت نیاز اصلاح کنید.', fromRecord: true, kind: 'shamsiDate' },
        { id: 'breedingMethod', group: 'breedingMethod', title: 'روش تلقیح / جفت‌گیری', sub: 'از پرونده خوانده شده؛ در صورت نیاز اصلاح کنید.', fromRecord: true, kind: 'choice', options: ['اسپرم تازه (Fresh)', 'اسپرم سردشده (Chilled)', 'اسپرم منجمد (Frozen)', 'جفت‌گیری طبیعی', 'مشخص نیست'] },
        { id: 'follicles', title: 'بررسی تخمدان‌ها و رحم', sub: 'روی نشانگرهای تخمدان‌ها و رحم بزنید تا فولیکول، جسم زرد (CL)، ادم و مایع رحمی را ثبت کنید.', kind: 'follicles' },
        { id: 'cervixCycle', group: 'cervixCycle', title: 'سرویکس', kind: 'choice', options: ['بسته', 'نیمه‌باز', 'باز'] },
        { id: 'ovEstimate', group: 'ovEstimate', title: 'ارزیابی زمان تخمک‌گذاری', kind: 'choice', options: ['احتمالاً کمتر از ۱۲ ساعت', '۱۲–۲۴ ساعت', 'بیش از ۲۴ ساعت', 'قابل تعیین نیست'] },
        { id: 'cycleAction', group: 'cycleAction', title: 'اقدام پیشنهادی', kind: 'choice', options: ['تلقیح امروز', 'کنترل مجدد ۱۲ ساعت', 'کنترل مجدد ۲۴ ساعت', 'بدون اقدام خاص'] }
      ],

      ovulation: [
        { id: 'ovContext', title: 'زمینه ویزیت', sub: 'اطلاعات پرونده مادیان از پیش بارگذاری شده و قابل ویرایش است.', fromRecord: true, kind: 'fields', fields: [
          { key: 'lastScan', label: 'زمان آخرین کنترل', type: 'text', placeholder: 'مثلاً ۱۸ ساعت قبل' },
          { key: 'lastBreedingDate', label: 'تاریخ آخرین تلقیح / جفت‌گیری', type: 'text' },
          { key: 'prevMethod', label: 'روش تلقیح قبلی', type: 'text' },
          { key: 'prevFollicleNote', label: 'فولیکول غالب قبلی', type: 'text' }
        ] },
        { id: 'previousFollicle', title: 'فولیکول غالب قبلی و وضعیت تخمدان‌ها', sub: 'روی نشانگر هر تخمدان بزنید، اندازه فولیکول را ثبت کنید و فولیکول غالب را تعیین کنید.', kind: 'follicles' },
        { id: 'ovResult', group: 'ovResult', title: 'نتیجه بررسی', kind: 'choice', options: ['تخمک‌گذاری انجام نشده', 'تخمک‌گذاری انجام شده', 'مشکوک / نامشخص'] },
        { id: 'ovSigns', group: 'ovSigns', title: 'یافته‌های حمایتی', sub: 'چند مورد را می‌توانید انتخاب کنید.', kind: 'multi', options: ['فولیکول Collapse شده', 'Corpus hemorrhagicum', 'CL جدید', 'مایع آزاد لگنی'], when: () => choices.ovResult === 'تخمک‌گذاری انجام شده' },
        { id: 'ovSide', group: 'ovSide', title: 'سمت تخمک‌گذاری', kind: 'choice', options: ['راست', 'چپ', 'نامشخص'], when: () => choices.ovResult === 'تخمک‌گذاری انجام شده' },
        { id: 'ovAction', group: 'ovAction', title: 'برنامه بعدی', kind: 'choice', options: ['بدون Recheck', 'کنترل مجدد ۱۲ ساعت', 'کنترل مجدد ۲۴ ساعت', 'بررسی آبستنی در موعد مقرر'] }
      ],

      pregnancy: [
        { id: 'pregDays', title: 'اطلاعات آبستنی', sub: 'از پرونده خوانده شده؛ در صورت نیاز اصلاح کنید.', fromRecord: true, kind: 'fields', fields: [{ key: 'daysPostBreeding', label: 'روز پس از تلقیح / جفت‌گیری', type: 'number', unit: 'روز' }] },
        { id: 'pregDate', key: 'pregBreedingDate', title: 'تاریخ آخرین تلقیح', sub: 'از پرونده خوانده شده؛ در صورت نیاز اصلاح کنید.', fromRecord: true, kind: 'shamsiDate' },
        { id: 'pregStatus', group: 'pregStatus', title: 'آبستنی در سونوگرافی', kind: 'choice', options: [{ label: 'مشاهده شد' }, { label: 'مشاهده نشد', cls: 'red' }, { label: 'مشکوک', cls: 'gold' }] },
        { id: 'vesicleCount', group: 'vesicleCount', title: 'تعداد وزیکول‌ها', kind: 'choice', options: ['۱', '۲', 'بیش از ۲'], when: () => choices.pregStatus === 'مشاهده شد' },
        { id: 'vesicleSize', key: 'vesicleSize', title: 'اندازه وزیکول اصلی', sub: 'اندازه را با اسلایدر تنظیم کنید.', kind: 'size', when: () => choices.pregStatus === 'مشاهده شد' },
        { id: 'pregLocation', group: 'pregLocation', title: 'محل وزیکول اصلی', kind: 'choice', options: ['شاخ راست', 'شاخ چپ', 'جسم رحم'], when: () => choices.pregStatus === 'مشاهده شد' },
        { id: 'embryoStatus', group: 'embryoStatus', title: 'Embryo / Fetal pole', kind: 'choice', options: ['مشاهده شد', 'مشاهده نشد', 'قابل ارزیابی نیست'], when: () => choices.pregStatus === 'مشاهده شد' },
        { id: 'heartbeat', group: 'heartbeat', title: 'ضربان قلب', kind: 'choice', options: ['مشاهده شد', 'مشاهده نشد', 'قابل ارزیابی نیست'], when: () => choices.pregStatus === 'مشاهده شد' && choices.embryoStatus === 'مشاهده شد' },
        { id: 'pregAppearance', group: 'pregAppearance', title: 'ظاهر کلی آبستنی', kind: 'choice', options: [{ label: 'طبیعی' }, { label: 'نیازمند پیگیری', cls: 'gold' }, { label: 'غیرطبیعی / مشکوک', cls: 'red' }], when: () => choices.pregStatus === 'مشاهده شد' },
        { id: 'pregUterus', group: 'pregUterus', title: 'رحم', kind: 'choice', options: ['طبیعی', 'مایع داخل رحم', 'یافته غیرطبیعی'], when: () => ['مشاهده نشد', 'مشکوک'].includes(choices.pregStatus) },
        { id: 'pregCL', group: 'pregCL', title: 'CL', kind: 'choice', options: ['مشاهده شد', 'مشاهده نشد', 'نامشخص'], when: () => ['مشاهده نشد', 'مشکوک'].includes(choices.pregStatus) },
        { id: 'pregAction', group: 'pregAction', title: 'برنامه پیگیری', kind: 'choice', options: ['Recheck در ۲۴–۴۸ ساعت', 'Recheck در چند روز آینده', 'پیگیری روتین آبستنی', 'اقدام/بررسی تکمیلی'] }
      ],

      problem: [
        { id: 'problemReason', group: 'problemReason', title: 'دلیل اصلی ارجاع', kind: 'choice', options: ['عدم آبستنی', 'تلفات زودرس آبستنی', 'ترشحات رحمی', 'سیکل نامنظم', 'یافته اتفاقی', 'سایر'] },
        { id: 'problemHistory', key: 'problemHistory', title: 'شرح کوتاه تاریخچه', sub: 'از پرونده خوانده شده؛ در صورت نیاز اصلاح کنید.', fromRecord: true, kind: 'textarea', placeholder: 'تعداد دفعات تلقیح، سابقه آبستنی، درمان قبلی و...' },
        { id: 'uterusProblem', group: 'uterusProblem', title: 'یافته‌های رحم', sub: 'چند مورد را می‌توانید انتخاب کنید.', kind: 'multi', options: ['مایع', 'ادم غیرمتناسب', 'کیست', 'ظاهر غیرطبیعی آندومتر', 'بدون یافته قابل توجه'] },
        { id: 'ovaryProblem', group: 'ovaryProblem', title: 'یافته‌های تخمدان', sub: 'چند مورد را می‌توانید انتخاب کنید.', kind: 'multi', options: ['ساختار کیستیک', 'CL پایدار/مشکوک', 'فولیکول غیرطبیعی', 'بدون یافته قابل توجه'] },
        { id: 'problemCervix', group: 'problemCervix', title: 'سرویکس', kind: 'choice', options: ['طبیعی', 'غیرطبیعی', 'ارزیابی نشد'] },
        { id: 'problemAssessment', key: 'problemAssessment', title: 'تشخیص / برداشت اولیه دامپزشک', kind: 'textarea' },
        { id: 'problemAction', group: 'problemAction', title: 'اقدام پیشنهادی', sub: 'چند مورد را می‌توانید انتخاب کنید.', kind: 'multi', options: ['نمونه‌گیری / آزمایش تکمیلی', 'درمان', 'Recheck سونوگرافی', 'ارجاع / بررسی تکمیلی'] }
      ],

      other: [
        { id: 'otherReason', key: 'otherReason', title: 'علت مراجعه', kind: 'field', placeholder: 'علت مراجعه را کوتاه بنویسید' },
        { id: 'otherFindings', key: 'otherFindings', title: 'یافته‌های سونوگرافی', kind: 'textarea', placeholder: 'یافته‌های مرتبط' },
        { id: 'otherPlan', key: 'otherPlan', title: 'نتیجه / توصیه', kind: 'textarea', placeholder: 'جمع‌بندی و برنامه بعدی' }
      ]
    };

    const imagesStep = { id: 'images', title: 'تصاویر سونوگرافی', sub: 'تصاویر در گزارش نهایی نمایش داده می‌شوند.', kind: 'images' };
    const noteStep = { id: 'note', title: 'توضیح تکمیلی دامپزشک', sub: 'اختیاری؛ تایپ کنید یا با میکروفون به فارسی دیکته کنید.', kind: 'note' };
    const summaryStep = { id: 'summary', title: 'پیش‌نمایش گزارش', sub: 'گزارش نهایی خود را مرور و ثبت کنید.', kind: 'summary' };

    function buildSteps() {
      const base = [bcsStep, breedStep, reasonStep];
      if (!currentReason) return base;
      return [...base, ...BRANCH_STEPS[currentReason], imagesStep, noteStep, summaryStep];
    }
    function visibleSteps() { return buildSteps().filter(s => !s.when || s.when()); }

    /* ================= helpers ================= */
    function toast(msg) {
      const t = document.getElementById('toast'); t.textContent = msg; t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 1700);
    }
    function norm(o) { return typeof o === 'string' ? { label: o, cls: '' } : o; }
    function active(g) { return choices[g] || 'ثبت نشده' }
    function multi(m) { return (multis[m] && multis[m].length) ? multis[m].join('، ') : 'ثبت نشده' }
    function val(k) { return (fields[k] || '').trim() || 'ثبت نشده' }
    function size(k) { return sizes[k] != null ? sizes[k] + ' میلی‌متر' : 'ثبت نشده' }

    /* ================= render ================= */
    function phaseInfo() {
      const intro = ['bcs', 'breed', 'reason'];
      if (intro.includes(currentId)) {
        return { idx: intro.indexOf(currentId), total: intro.length };
      }
      const branch = visibleSteps().filter(s => !intro.includes(s.id));
      return { idx: branch.findIndex(s => s.id === currentId), total: branch.length };
    }

    function renderStep() {
      const vis = visibleSteps();
      const idx = vis.findIndex(s => s.id === currentId);
      const step = vis[idx];
      const ph = phaseInfo();
      stopVoice();
      const box = document.getElementById('step');
      box.innerHTML = '';
      const wrap = document.createElement('div');
      wrap.className = 'step';
      box.appendChild(wrap);

      const tl = document.createElement('div');
      tl.className = 'topline';
      const counter = document.createElement('span');
      counter.className = 'counter';
      counter.innerHTML = '<span class="dot"></span>سؤال ' + fa(ph.idx + 1) + ' از ' + fa(ph.total);
      tl.appendChild(counter);
      wrap.appendChild(tl);

      const card = document.createElement('div');
      card.className = 'card';
      const h = document.createElement('h2'); h.textContent = step.title; card.appendChild(h);
      if (step.sub) { const s = document.createElement('p'); s.className = 'sub'; s.textContent = step.sub; card.appendChild(s); }
      if (step.fromRecord) {
        const ban = document.createElement('div');
        ban.className = 'recordBanner';
        ban.innerHTML = '<span class="recordTag">از پرونده</span><span>این موارد از پرونده مادیان بارگذاری شده‌اند و بعداً از پایگاه‌داده خوانده می‌شوند. در صورت نیاز ویرایش کنید.</span>';
        card.appendChild(ban);
      }
      wrap.appendChild(card);

      if (step.kind === 'choice') renderChoice(card, step);
      else if (step.kind === 'scale') renderScale(card, step);
      else if (step.kind === 'multi') renderMulti(card, step);
      else if (step.kind === 'fields') renderFields(card, step);
      else if (step.kind === 'field') renderFields(card, { fields: [step] });
      else if (step.kind === 'textarea') renderFields(card, { fields: [{ key: step.key, type: 'textarea', placeholder: step.placeholder }] });
      else if (step.kind === 'shamsiDate') renderShamsiDate(card, step);
      else if (step.kind === 'size') renderSize(card, step);
      else if (step.kind === 'follicles') renderFollicles(card, step);
      else if (step.kind === 'images') renderImages(card);
      else if (step.kind === 'note') renderNote(card);
      else if (step.kind === 'summary') renderSummary(card);

      const prev = document.getElementById('btnPrev');
      const next = document.getElementById('btnNext');
      prev.disabled = idx <= 0;
      prev.classList.toggle('ghostSlot', idx <= 0);
      const hasChoice = (step.kind === 'choice' || step.kind === 'scale') && choices[step.group];
      const needsNext = hasChoice || ['fields', 'field', 'textarea', 'multi', 'images', 'note', 'size', 'follicles', 'shamsiDate'].includes(step.kind);
      next.classList.toggle('ghostSlot', !needsNext);
      next.disabled = !needsNext;
      next.textContent = 'بعدی';

      document.getElementById('progressBar').style.width = Math.round(((ph.idx + 1) / ph.total) * 100) + '%';
      window.scrollTo({ top: 0 });
    }

    function renderChoice(card, step) {
      const wrap = document.createElement('div');
      wrap.className = 'opts';
      step.options.forEach(o => {
        const { label, cls } = norm(o);
        const b = document.createElement('button');
        b.className = 'opt ' + cls + (choices[step.group] === label ? ' active' : '');
        b.innerHTML = '<span>' + label + '</span><span class="chk">✓</span>';
        b.onclick = () => onChoice(step, label);
        wrap.appendChild(b);
      });
      card.appendChild(wrap);
      if (step.legend) {
        const l = document.createElement('p');
        l.className = 'sub'; l.style.margin = '14px 0 0'; l.style.textAlign = 'center';
        l.innerHTML = step.legend;
        card.appendChild(l);
      }
    }

    function onChoice(step, label) {
      choices[step.group] = label;
      if (step.id === 'bcs') bcs = label;
      if (step.id === 'reason') {
        const r = REASONS.find(x => x.label === label);
        currentReason = r.key;
        document.getElementById('branchName').textContent = r.label;
        delete sizes.rightFollicle;
        delete sizes.leftFollicle;
        delete choices.dominantSide;
        dominantManual = false;
        follicleSide = null;
        anov.right = false;
        anov.left = false;
        clState.right = { observed: false, size: null };
        clState.left = { observed: false, size: null };
        delete choices.edemaCycle;
        choices.fluidCycle = 'ندارد';

        if (currentReason === 'ovulation') {
          sizes.rightFollicle = RECORD.prevRightFollicle;
          sizes.leftFollicle = RECORD.prevLeftFollicle;
          choices.dominantSide = RECORD.prevDominantSide;
        }
        currentId = BRANCH_STEPS[currentReason][0].id;
        renderStep();
        return;
      }
      renderStep();
      setTimeout(next, 240);
    }

    function renderScale(card, step) {
      const wrap = document.createElement('div');
      wrap.className = 'scale';
      step.options.forEach(o => {
        const { label } = norm(o);
        const b = document.createElement('button');
        b.textContent = label;
        if (choices[step.group] === label) b.classList.add('active');
        b.onclick = () => onChoice(step, label);
        wrap.appendChild(b);
      });
      card.appendChild(wrap);
    }

    function renderMulti(card, step) {
      const wrap = document.createElement('div');
      wrap.className = 'opts';
      const sel = multis[step.group] || [];
      step.options.forEach(o => {
        const { label, cls } = norm(o);
        const b = document.createElement('button');
        b.className = 'opt ' + cls + (sel.includes(label) ? ' active' : '');
        b.innerHTML = '<span>' + label + '</span><span class="chk">✓</span>';
        b.onclick = () => {
          if (!multis[step.group]) multis[step.group] = [];
          const arr = multis[step.group];
          const i = arr.indexOf(label);
          if (i >= 0) arr.splice(i, 1); else arr.push(label);
          renderStep();
        };
        wrap.appendChild(b);
      });
      card.appendChild(wrap);
    }

    function renderFields(card, step) {
      step.fields.forEach(f => {
        const div = document.createElement('div');
        div.className = 'field';
        const lbl = document.createElement('label'); lbl.textContent = f.label; div.appendChild(lbl);
        if (f.type === 'select') {
          const sel = document.createElement('select');
          sel.dataset.key = f.key;
          const def = document.createElement('option'); def.value = ''; def.textContent = 'انتخاب...'; sel.appendChild(def);
          f.options.forEach(o => { const op = document.createElement('option'); op.textContent = o; sel.appendChild(op); });
          sel.value = fields[f.key] || '';
          sel.onchange = () => { fields[f.key] = sel.value; };
          div.appendChild(sel);
        } else if (f.type === 'textarea') {
          const ta = document.createElement('textarea');
          ta.dataset.key = f.key;
          ta.placeholder = f.placeholder || '';
          ta.value = fields[f.key] || '';
          ta.oninput = () => { fields[f.key] = ta.value; };
          div.appendChild(ta);
        } else {
          const uw = document.createElement('div'); uw.className = 'unitwrap';
          const inp = document.createElement('input');
          inp.type = f.type || 'text';
          inp.dataset.key = f.key;
          inp.placeholder = f.placeholder || '';
          inp.value = fields[f.key] || '';
          if (f.type === 'number') inp.inputMode = 'numeric';
          inp.oninput = () => { fields[f.key] = inp.value; };
          uw.appendChild(inp);
          if (f.unit) { const u = document.createElement('span'); u.className = 'u'; u.textContent = f.unit; uw.appendChild(u); }
          div.appendChild(uw);
        }
        card.appendChild(div);
      });
    }

    /* ================= Shamsi date step ================= */
    function renderShamsiDate(card, step) {
      const key = step.key;
      const today = new Date();
      const tj = g2j(today.getFullYear(), today.getMonth() + 1, today.getDate());
      const ty = tj[0], tm = tj[1], td = tj[2];
      const committed = dates[key];
      let sel = committed ? { jy: committed.jy, jm: committed.jm, jd: committed.jd } : { jy: ty, jm: tm, jd: td };

      const ITEM = 36;
      const Y0 = ty - 10, Y1 = ty + 1;

      const disp = document.createElement('button');
      disp.type = 'button';
      function refreshDisp() {
        if (fields[key] === 'مشخص نیست') {
          disp.className = 'dateField';
          disp.innerHTML = '<span class="calIco">📅</span><span>مشخص نیست</span>';
          return;
        }
        const isToday = sel.jy === ty && sel.jm === tm && sel.jd === td;
        disp.className = 'dateField' + (dates[key] ? '' : ' empty');
        disp.innerHTML = '<span class="calIco">📅</span><span>' + fmtJ(sel.jy, sel.jm, sel.jd) +
          (isToday && !dates[key] ? ' <small style="color:#1f6049">(امروز)</small>' : '') + '</span>';
      }
      refreshDisp();
      card.appendChild(disp);

      const calWrap = document.createElement('div');
      calWrap.className = 'calWrap open';
      card.appendChild(calWrap);

      function clampDay() {
        const len = monthLen(sel.jy, sel.jm);
        if (sel.jd > len) sel.jd = len;
      }

      function commit() {
        dates[key] = { jy: sel.jy, jm: sel.jm, jd: sel.jd };
        fields[key] = fmtJ(sel.jy, sel.jm, sel.jd);
        renderStep();
        setTimeout(next, 220);
      }

      function colHTML(kind) {
        let items = [];
        if (kind === 'year') { for (let y = Y0; y <= Y1; y++) items.push({ v: y, t: fa(y) }); }
        else if (kind === 'month') { for (let m = 1; m <= 12; m++) items.push({ v: m, t: MONTHS[m] }); }
        else { const len = monthLen(sel.jy, sel.jm); for (let d = 1; d <= len; d++) items.push({ v: d, t: fa(d) }); }
        return '<div class="iosPad"></div><div class="iosPad"></div>' +
          items.map(it => '<div class="iosItem" data-v="' + it.v + '">' + it.t + '</div>').join('') +
          '<div class="iosPad"></div><div class="iosPad"></div>';
      }

      function markOn(col) {
        const el = calWrap.querySelector('.iosCol[data-col="' + col + '"]');
        if (!el) return;
        const v = col === 'year' ? sel.jy : col === 'month' ? sel.jm : sel.jd;
        el.querySelectorAll('.iosItem').forEach(it => it.classList.toggle('on', String(it.dataset.v) === String(v)));
      }

      function scrollColTo(col, v, smooth) {
        const el = calWrap.querySelector('.iosCol[data-col="' + col + '"]');
        if (!el) return;
        const item = el.querySelector('.iosItem[data-v="' + v + '"]');
        if (!item) return;
        el.scrollTo({ top: item.offsetTop - ITEM * 2, behavior: smooth ? 'smooth' : 'auto' });
        markOn(col);
      }

      function snapAll(smooth) {
        scrollColTo('year', sel.jy, smooth);
        scrollColTo('month', sel.jm, smooth);
        scrollColTo('day', sel.jd, smooth);
      }

      function rebuildDay() {
        clampDay();
        const dayCol = calWrap.querySelector('.iosCol[data-col="day"]');
        if (!dayCol) return;
        dayCol.innerHTML = colHTML('day');
        requestAnimationFrame(() => scrollColTo('day', sel.jd, false));
      }

      function drawMini() {
        const box = calWrap.querySelector('#cal-mini');
        if (!box) return;
        const len = monthLen(sel.jy, sel.jm);
        const off = jWeekday(sel.jy, sel.jm, 1);
        let h = '<div class="calGrid">';
        DOWS.forEach(d => { h += '<span class="dow">' + d + '</span>'; });
        for (let i = 0; i < off; i++) h += '<span></span>';
        for (let d = 1; d <= len; d++) {
          let cls = 'day';
          if (sel.jy === ty && sel.jm === tm && d === td) cls += ' today';
          if (sel.jd === d) cls += ' sel';
          h += '<button type="button" class="' + cls + '" data-day="' + d + '">' + fa(d) + '</button>';
        }
        h += '</div>';
        box.innerHTML = h;
        box.querySelectorAll('.day').forEach(b => {
          b.onclick = () => {
            sel.jd = parseInt(b.dataset.day, 10);
            scrollColTo('day', sel.jd, true);
            drawMini();
            refreshDisp();
          };
        });
      }

      function applyFromWheel(col) {
        const el = calWrap.querySelector('.iosCol[data-col="' + col + '"]');
        const idx = Math.max(0, Math.round(el.scrollTop / ITEM));
        const items = el.querySelectorAll('.iosItem');
        const it = items[Math.min(idx, items.length - 1)];
        if (!it) return;
        const v = parseInt(it.dataset.v, 10);
        if (col === 'year') sel.jy = v;
        else if (col === 'month') sel.jm = v;
        else sel.jd = v;
        if (col !== 'day') rebuildDay();
        markOn(col);
        drawMini();
        refreshDisp();
      }

      function bindWheel(col) {
        const el = calWrap.querySelector('.iosCol[data-col="' + col + '"]');
        let t;
        el.addEventListener('scroll', () => {
          clearTimeout(t);
          const idx = Math.max(0, Math.round(el.scrollTop / ITEM));
          const items = el.querySelectorAll('.iosItem');
          items.forEach((it, i) => it.classList.toggle('on', i === idx));
          t = setTimeout(() => applyFromWheel(col), 80);
        }, { passive: true });
      }

      calWrap.innerHTML =
        '<div class="iosLabs"><span>سال</span><span>ماه</span><span>روز</span></div>' +
        '<div class="iosPicker">' +
          '<div class="iosHi"></div>' +
          '<div class="iosFade iosFadeT"></div>' +
          '<div class="iosFade iosFadeB"></div>' +
          '<div class="iosCol" data-col="year">' + colHTML('year') + '</div>' +
          '<div class="iosCol" data-col="month">' + colHTML('month') + '</div>' +
          '<div class="iosCol" data-col="day">' + colHTML('day') + '</div>' +
        '</div>' +
        '<div id="cal-mini"></div>' +
        '<div class="calFoot">' +
          '<button type="button" class="calToday">امروز</button>' +
          '<button type="button" class="calUnknown">مشخص نیست</button>' +
          '<button type="button" class="confirmBtn">✓ ثبت این تاریخ</button>' +
        '</div>';

      bindWheel('year'); bindWheel('month'); bindWheel('day');
      calWrap.querySelector('.calToday').onclick = () => {
        fields[key] = fmtJ(ty, tm, td);
        sel = { jy: ty, jm: tm, jd: td };
        rebuildDay();
        requestAnimationFrame(() => { snapAll(true); drawMini(); refreshDisp(); });
      };
      calWrap.querySelector('.calUnknown').onclick = () => {
        delete dates[key];
        fields[key] = 'مشخص نیست';
        renderStep();
        setTimeout(next, 220);
      };
      calWrap.querySelector('.confirmBtn').onclick = commit;

      requestAnimationFrame(() => {
        snapAll(false);
        drawMini();
      });
    }

    /* ================= size picker (overlay) ================= */
    function popConfig() {
      if (!curFollicle) return { min: 0, max: 70, presets: [10, 20, 30, 40, 50], typical: '' };
      if (anovOn) return Object.assign({}, ANOV_RANGE);
      const breed = choices.breed || 'نامشخص';
      return Object.assign({}, (BREED_RANGE[breed] || BREED_RANGE['نامشخص']));
    }
    function clampVal(v) {
      const c = popConfig();
      return Math.max(c.min, Math.min(c.max, v));
    }

    function buildPopover(host, title, isFollicle) {
      curFollicle = !!isFollicle;
      host.querySelector('.popover')?.remove();
      host.querySelector('.wrapScrim')?.remove();
      const scrim = document.createElement('div');
      scrim.className = 'wrapScrim';
      scrim.onclick = closePopover;
      host.appendChild(scrim);
      const pop = document.createElement('div');
      pop.className = 'popover';
      host.appendChild(pop);
      fillPopover(pop, title);
      return pop;
    }

    function fillPopover(pop, title) {
      if (sheetKey === 'edema') {
        fillEdemaPopover(pop);
        return;
      }
      if (sheetKey === 'fluid') {
        fillFluidPopover(pop);
        return;
      }

      const cfg = popConfig();
      const raw = sizes[sheetKey] != null ? sizes[sheetKey] : 0;
      const v = clampVal(raw);
      const side = follicleSide;
      const curCL = clState[side] || { observed: false, size: null };
      let clObserved = curCL.observed;
      let clSize = curCL.size || 20;

      let h = '<div class="popHead"><span class="lbl">' + title + '</span></div>' +
        '<div class="popValue" id="pop-value">' + fa(v) + ' <small>mm</small></div>' +
        '<div class="stepper">' +
        '<button type="button" class="stepBtn" id="pop-minus">−</button>' +
        '<input type="number" id="num-input" inputmode="numeric" min="' + cfg.min + '" max="' + cfg.max + '" value="' + v + '">' +
        '<button type="button" class="stepBtn" id="pop-plus">+</button>' +
        '<span class="mm">میلی‌متر</span>' +
        '</div>' +
        '<div class="rangeRow"><span class="min">' + fa(cfg.min) + '</span>' +
        '<input type="range" id="pop-range" min="' + cfg.min + '" max="' + cfg.max + '" step="1" value="' + v + '">' +
        '<span class="max">' + fa(cfg.max) + '</span></div>' +
        '<div class="presets">' +
        cfg.presets.map(p => '<button type="button" data-v="' + p + '">' + fa(p) + '</button>').join('') +
        '</div>';

      if (curFollicle) {
        h += '<div style="text-align:center;margin-top:10px">' +
          '<button type="button" id="anov-toggle" style="border:1.5px solid ' + (anovOn ? 'var(--red)' : 'var(--line)') +
          ';background:' + (anovOn ? 'var(--red2)' : '#fff') + ';color:' + (anovOn ? 'var(--red)' : '#777') +
          ';border-radius:99px;padding:8px 14px;font-size:12px;font-weight:700">' +
          (anovOn ? '✓ ' : '') + 'فولیکول غیرطبیعی (آنوولاتوری / هموراژیک)' +
          '</button></div>';
      }
      if (cfg.typical) {
        h += '<div style="text-align:center;font-size:11px;color:#b9831d;margin-top:8px;font-weight:700">' + cfg.typical + '</div>';
      }

      /* CL section in ovary modal */
      if (side) {
        const clMin = 10, clMax = 60;
        const clPresets = [15, 20, 25, 30, 35, 40];
        h += '<div class="popSection">' +
          '<div class="popSectionTitle"><span>جسم زرد (Corpus Luteum - CL)</span></div>' +
          '<div class="popTogglePills">' +
          '<button type="button" class="clToggleBtn' + (!clObserved ? ' active' : '') + '" data-cl="none">مشاهده نشد</button>' +
          '<button type="button" class="clToggleBtn' + (clObserved ? ' active' : '') + '" data-cl="seen">مشاهده شد (دارای CL)</button>' +
          '</div>' +
          '<div id="cl-size-wrap" style="display:' + (clObserved ? 'block' : 'none') + ';margin-top:8px">' +
          '<div class="popValue" id="cl-pop-value" style="font-size:22px;margin:2px 0 6px">' + fa(clSize) + ' <small>mm</small></div>' +
          '<div class="stepper">' +
          '<button type="button" class="stepBtn" id="cl-minus">−</button>' +
          '<input type="number" id="cl-num-input" inputmode="numeric" min="' + clMin + '" max="' + clMax + '" value="' + clSize + '">' +
          '<button type="button" class="stepBtn" id="cl-plus">+</button>' +
          '<span class="mm">میلی‌متر</span>' +
          '</div>' +
          '<div class="rangeRow"><span class="min">' + fa(clMin) + '</span>' +
          '<input type="range" id="cl-range" min="' + clMin + '" max="' + clMax + '" step="1" value="' + clSize + '">' +
          '<span class="max">' + fa(clMax) + '</span></div>' +
          '<div class="presets">' +
          clPresets.map(p => '<button type="button" class="clPresetBtn" data-v="' + p + '">' + fa(p) + '</button>').join('') +
          '</div>' +
          '</div>' +
          '</div>';
      }

      h += '<div class="popBtns">' +
        '<button type="button" class="clear" id="pop-clear">حذف مقدار</button>' +
        '<button type="button" class="ok" id="pop-ok">تأیید ✓</button>' +
        '</div>';
      pop.innerHTML = h;

      const range = pop.querySelector('#pop-range');
      const num = pop.querySelector('#num-input');

      range.addEventListener('input', e => {
        const val = clampVal(parseInt(e.target.value, 10) || 0);
        range.value = val;
        num.value = val;
        onPopSlide(val);
      });
      num.addEventListener('input', () => {
        let val = parseInt(num.value, 10);
        if (isNaN(val)) val = 0;
        val = clampVal(val);
        range.value = val;
        onPopSlide(val);
      });
      num.addEventListener('focus', () => num.select());
      pop.querySelector('#pop-minus').onclick = () => {
        const val = clampVal((parseInt(range.value, 10) || 0) - 1);
        range.value = val; num.value = val; onPopSlide(val);
      };
      pop.querySelector('#pop-plus').onclick = () => {
        const val = clampVal((parseInt(range.value, 10) || 0) + 1);
        range.value = val; num.value = val; onPopSlide(val);
      };
      pop.querySelectorAll('.presets button:not(.clPresetBtn)').forEach(b => b.onclick = () => {
        range.value = b.dataset.v; num.value = b.dataset.v;
        onPopSlide(parseInt(b.dataset.v, 10));
      });

      /* Bind CL toggle & range slider */
      if (side) {
        const clWrap = pop.querySelector('#cl-size-wrap');
        const clNum = pop.querySelector('#cl-num-input');
        const clRange = pop.querySelector('#cl-range');
        const clValDisp = pop.querySelector('#cl-pop-value');

        function updateCL(v) {
          clSize = Math.max(10, Math.min(60, v));
          if (clNum && document.activeElement !== clNum) clNum.value = clSize;
          if (clRange) clRange.value = clSize;
          if (clValDisp) clValDisp.innerHTML = fa(clSize) + ' <small>mm</small>';
        }

        pop.querySelectorAll('.clToggleBtn').forEach(b => {
          b.onclick = () => {
            clObserved = b.dataset.cl === 'seen';
            pop.querySelectorAll('.clToggleBtn').forEach(btn => btn.classList.toggle('active', btn === b));
            if (clWrap) clWrap.style.display = clObserved ? 'block' : 'none';
          };
        });

        if (clRange) {
          clRange.addEventListener('input', e => {
            updateCL(parseInt(e.target.value, 10) || 20);
          });
        }
        if (clNum) {
          clNum.addEventListener('input', () => {
            let v = parseInt(clNum.value, 10);
            if (isNaN(v)) v = 10;
            updateCL(v);
          });
          clNum.addEventListener('focus', () => clNum.select());
        }
        pop.querySelector('#cl-minus')?.addEventListener('click', () => {
          updateCL(clSize - 1);
        });
        pop.querySelector('#cl-plus')?.addEventListener('click', () => {
          updateCL(clSize + 1);
        });
        pop.querySelectorAll('.clPresetBtn').forEach(btn => {
          btn.onclick = () => {
            updateCL(parseInt(btn.dataset.v, 10));
          };
        });
      }

      pop.querySelector('#pop-clear').onclick = () => clearSize(side);
      pop.querySelector('#pop-ok').onclick = () => confirmSize(side, clObserved, clSize);
      if (curFollicle) {
        pop.querySelector('#anov-toggle').onclick = () => {
          anovOn = !anovOn;
          fillPopover(pop, title);
          const rr = pop.querySelector('#pop-range');
          onPopSlide(parseInt(rr.value, 10) || 0);
        };
      }
    }

    /* Edema Popover */
    function fillEdemaPopover(pop) {
      const curEdema = choices.edemaCycle || '';
      const options = [
        { label: '۰ تا ۱', desc: 'حداقل ادم / نرمال دیستروس' },
        { label: '۱ تا ۲', desc: 'ادم خفیف تا متوسط' },
        { label: '۲ تا ۳', desc: 'فحلی فعال / Cartwheel واضح' },
        { label: '۳ تا ۴', desc: 'پیش از تخمک‌گذاری / ادم شدید' },
        { label: 'هایپر ادم (Hyper edema)', desc: 'ادم پاتولوژیک / بیش از حد / التهابی' }
      ];

      let h = '<div class="popHead"><span class="lbl">درجه ادم رحم (Uterine Edema)</span></div>' +
        '<div style="font-size:11px;color:#777;margin-bottom:8px">درجه ادم دیواره رحم را انتخاب کنید:</div>' +
        '<div class="edemaOptionList">' +
        options.map(opt =>
          '<button type="button" class="edemaBtn' + (curEdema === opt.label ? ' active' : '') + '" data-val="' + opt.label + '">' +
          '<span><b>' + opt.label + '</b> <small style="color:#777">(' + opt.desc + ')</small></span>' +
          '<span>✓</span>' +
          '</button>'
        ).join('') +
        '</div>' +
        '<div class="popBtns">' +
        '<button type="button" class="clear" id="edema-clear">بدون ادم (۰)</button>' +
        '<button type="button" class="ok" id="edema-ok">تأیید ✓</button>' +
        '</div>';

      pop.innerHTML = h;
      let selected = curEdema;

      pop.querySelectorAll('.edemaBtn').forEach(btn => {
        btn.onclick = () => {
          selected = btn.dataset.val;
          pop.querySelectorAll('.edemaBtn').forEach(b => b.classList.toggle('active', b === btn));
        };
      });

      pop.querySelector('#edema-clear').onclick = () => {
        choices.edemaCycle = '۰';
        closePopover();
        refreshAllAnatomyMarkers();
        toast('ادم رحم: ۰ ثبت شد');
      };
      pop.querySelector('#edema-ok').onclick = () => {
        if (selected) choices.edemaCycle = selected;
        closePopover();
        refreshAllAnatomyMarkers();
        toast('ادم رحم ثبت شد');
      };
    }

    /* Fluid Popover */
    function fillFluidPopover(pop) {
      let curAmount = choices.fluidCycle || 'ندارد';
      let curEcho = fields.fluidEcho || '';

      const amounts = [
        { label: 'ندارد', desc: 'بدون مایع داخل لومن' },
        { label: 'کم', desc: 'ردپای مایع / < 1cm' },
        { label: 'متوسط', desc: '1 تا 2cm' },
        { label: 'زیاد', desc: 'تجمع فراوان / > 2cm' }
      ];

      const echos = ['Anechoic (زلال)', 'Hyperechoic (کدر / چرکی)', 'حاوی فیبرین / ترشحات'];

      let h = '<div class="popHead"><span class="lbl">مایع داخل رحم (Intrauterine Fluid)</span></div>' +
        '<div style="font-size:11px;color:#777;margin-bottom:6px">میزان تجمع مایع در لومن رحم:</div>' +
        '<div class="fluidOptionList">' +
        amounts.map(opt =>
          '<button type="button" class="fluidBtn' + (curAmount === opt.label ? ' active' : '') + '" data-amount="' + opt.label + '">' +
          '<span><b>' + opt.label + '</b> <small style="color:#777">(' + opt.desc + ')</small></span>' +
          '<span>✓</span>' +
          '</button>'
        ).join('') +
        '</div>' +
        '<div id="echo-section" style="display:' + (curAmount !== 'ندارد' ? 'block' : 'none') + ';margin-top:10px;border-top:1px dashed #eee;padding-top:8px">' +
        '<div style="font-size:11px;font-weight:700;color:#666;margin-bottom:6px">اکوژنیسیته / ویژگی مایع:</div>' +
        '<div style="display:flex;flex-direction:column;gap:6px">' +
        echos.map(ec =>
          '<button type="button" class="fluidBtn echoBtn' + (curEcho === ec ? ' active' : '') + '" data-echo="' + ec + '">' +
          '<span>' + ec + '</span><span>✓</span>' +
          '</button>'
        ).join('') +
        '</div>' +
        '</div>' +
        '<div class="popBtns">' +
        '<button type="button" class="clear" id="fluid-clear">بدون مایع (ندارد)</button>' +
        '<button type="button" class="ok" id="fluid-ok">تأیید ✓</button>' +
        '</div>';

      pop.innerHTML = h;

      const echoSec = pop.querySelector('#echo-section');

      pop.querySelectorAll('.fluidBtn[data-amount]').forEach(btn => {
        btn.onclick = () => {
          curAmount = btn.dataset.amount;
          pop.querySelectorAll('.fluidBtn[data-amount]').forEach(b => b.classList.toggle('active', b === btn));
          if (echoSec) echoSec.style.display = curAmount !== 'ندارد' ? 'block' : 'none';
        };
      });

      pop.querySelectorAll('.echoBtn').forEach(btn => {
        btn.onclick = () => {
          curEcho = btn.dataset.echo;
          pop.querySelectorAll('.echoBtn').forEach(b => b.classList.toggle('active', b === btn));
        };
      });

      pop.querySelector('#fluid-clear').onclick = () => {
        choices.fluidCycle = 'ندارد';
        fields.fluidEcho = '';
        closePopover();
        refreshAllAnatomyMarkers();
        toast('مایع رحم: ندارد ثبت شد');
      };

      pop.querySelector('#fluid-ok').onclick = () => {
        choices.fluidCycle = curAmount;
        fields.fluidEcho = curAmount !== 'ندارد' ? curEcho : '';
        closePopover();
        refreshAllAnatomyMarkers();
        toast('مایع رحم ثبت شد');
      };
    }

    function openPopover() {
      const pop = document.querySelector('.popover');
      if (!pop) return;
      pop.classList.add('open');
      const scrim = pop.parentElement.querySelector('.wrapScrim');
      if (scrim) scrim.classList.add('show');
      const range = document.getElementById('pop-range');
      if (range) {
        const v = sizes[sheetKey] != null ? sizes[sheetKey] : 0;
        range.value = clampVal(v);
        const num = document.getElementById('num-input');
        if (num) num.value = range.value;
        onPopSlide(parseInt(range.value, 10) || 0);
      }
    }

    function clearSize(side) {
      delete sizes[sheetKey];
      if (side) {
        anov[side] = false;
        clState[side] = { observed: false, size: null };
      }
      const isCombined = sheetKey === 'rightFollicle' || sheetKey === 'leftFollicle';
      closePopover();
      if (isCombined) {
        refreshAllAnatomyMarkers();
        syncDominantFromSize();
        toast('حذف شد');
      } else {
        renderStep();
      }
    }

    function closePopover() {
      document.querySelectorAll('.popover').forEach(p => p.classList.remove('open'));
      document.querySelectorAll('.wrapScrim').forEach(s => s.classList.remove('show'));
    }

    function onPopSlide(v) {
      const pv = document.getElementById('pop-value');
      if (pv) pv.innerHTML = fa(v) + ' <small>mm</small>';
      const num = document.getElementById('num-input');
      if (num && document.activeElement !== num) num.value = v;
      if (sheetKey === 'rightFollicle' || sheetKey === 'leftFollicle') {
        drawFollicleMarker(v);
        syncDominantFromSize();
      } else drawFollicleSVG(v);
    }

    function confirmSize(side, clObserved, clSize) {
      const range = document.getElementById('pop-range');
      const v = range ? (parseInt(range.value, 10) || 0) : 0;
      if (v > 0) sizes[sheetKey] = v; else delete sizes[sheetKey];

      if (side) {
        anov[side] = !!anovOn;
        clState[side] = {
          observed: !!clObserved,
          size: clObserved ? (parseInt(clSize, 10) || 20) : null
        };
      }

      if ((sheetKey === 'rightFollicle' || sheetKey === 'leftFollicle')) {
        syncDominantFromSize();
      }

      closePopover();
      if (sheetKey === 'rightFollicle' || sheetKey === 'leftFollicle') {
        refreshAllAnatomyMarkers();
        toast('تخمدان ' + (side === 'right' ? 'راست' : 'چپ') + ' ثبت شد');
      } else {
        renderStep();
        setTimeout(next, 200);
      }
    }

    /* ================= single-size SVG ================= */
    const FSCALE = 1.15;
    function follicleSVG(v) {
      const r = v > 0 ? Math.min(64, Math.max(6, v * FSCALE)) : 0;
      const ref = 10 * FSCALE;
      let foll = '';
      if (r > 0) {
        foll = '<circle cx="130" cy="92" r="' + r + '" fill="url(#follGrad)" stroke="#dfe8f2" stroke-width="3"/>' +
          '<ellipse cx="' + (130 - r * 0.32) + '" cy="' + (92 - r * 0.36) + '" rx="' + (r * 0.22) + '" ry="' + (r * 0.15) + '" fill="#ffffff" opacity="0.28" transform="rotate(-28 ' + (130 - r * 0.32) + ' ' + (92 - r * 0.36) + ')"/>';
        if (r > 20) foll += '<text x="130" y="' + (92 + r * 0.28) + '" font-size="' + Math.min(20, r * 0.62) + '" text-anchor="middle" fill="#ffffff" font-weight="700">' + fa(v) + '</text>';
      }
      return '<svg viewBox="0 0 260 185" xmlns="http://www.w3.org/2000/svg" font-family="IRANSansX, Tahoma, sans-serif">' +
        '<defs>' +
        '<radialGradient id="follGrad" cx="40%" cy="34%" r="78%"><stop offset="0%" stop-color="#43434a"/><stop offset="100%" stop-color="#121215"/></radialGradient>' +
        '<radialGradient id="ovGrad" cx="35%" cy="30%" r="85%"><stop offset="0%" stop-color="#fbf2ed"/><stop offset="100%" stop-color="#ecd8cf"/></radialGradient>' +
        '</defs>' +
        '<ellipse cx="130" cy="92" rx="102" ry="63" fill="url(#ovGrad)" stroke="#e3c9bd" stroke-width="2.5"/>' +
        '<circle cx="196" cy="52" r="13" fill="url(#follGrad)" stroke="#dfe8f2" stroke-width="2" opacity="0.9"/>' +
        '<circle cx="36" cy="34" r="' + ref + '" fill="none" stroke="#b9c6bf" stroke-width="2" stroke-dasharray="3 3"/>' +
        '<text x="36" y="56" text-anchor="middle" font-size="10" fill="#9aa7a0">۱۰mm</text>' +
        foll + '</svg>';
    }

    function renderSize(card, step) {
      const v = sizes[step.key];
      const box = document.createElement('div');
      box.className = 'follicleWrap';
      box.id = 'foll-svg';
      box.innerHTML = follicleSVG(v);
      box.onclick = () => { sheetKey = step.key; buildPopover(box, step.title, step.key !== 'vesicleSize'); openPopover(); };
      card.appendChild(box);

      const valLbl = document.createElement('div');
      valLbl.className = 'follicleVal';
      valLbl.id = 'foll-label';
      valLbl.innerHTML = v != null ? fa(v) + ' میلی‌متر' : '<span>برای تنظیم، روی تصویر بزنید</span>';
      card.appendChild(valLbl);
    }

    function drawFollicleSVG(v) {
      const svg = document.getElementById('foll-svg');
      if (svg) svg.innerHTML = follicleSVG(v);
      const lbl = document.getElementById('foll-label');
      if (lbl) lbl.innerHTML = v > 0 ? fa(v) + ' میلی‌متر' : '<span>برای تنظیم، روی تصویر بزنید</span>';
    }

    /* ================= combined follicles & anatomy page ================= */
    function markerHTML(type, side) {
      if (type === 'follicle') {
        const key = side + 'Follicle';
        const v = sizes[key];
        const pos = FOL_POS[side];
        const label = side === 'right' ? 'تخمدان راست' : 'تخمدان چپ';
        const isAnov = anov[side];
        const clInfo = clState[side];
        const foll = v != null ? '<span class="ffollicle" style="width:' + fpx(v) + 'px;height:' + fpx(v) + 'px">' + fa(v) + '</span>' : '';
        let chipText = label;
        if (v != null) chipText += ' · ' + fa(v) + 'mm';
        if (isAnov) chipText += ' (هموراژیک)';
        if (clInfo && clInfo.observed) chipText += ' | CL' + (clInfo.size ? ' ' + fa(clInfo.size) + 'mm' : '');

        let classes = 'fmarker';
        if (follicleSide === side) classes += ' sel';
        if (isAnov) classes += ' anov';

        return '<button type="button" class="' + classes + '" data-type="follicle" data-side="' + side + '" style="left:' + pos.x + '%;top:' + pos.y + '%">' +
          foll +
          '<span class="fdot"></span>' +
          '<span class="fchip">' + chipText + '</span>' +
          '</button>';
      } else if (type === 'edema') {
        const pos = FOL_POS.edema;
        const ed = choices.edemaCycle;
        const hasEdema = ed && ed !== 'بدون ادم' && ed !== '۰';
        const chipText = 'ادم رحم: ' + (ed || 'ثبت');
        return '<button type="button" class="fmarker' + (hasEdema ? ' active' : '') + '" data-type="edema" style="left:' + pos.x + '%;top:' + pos.y + '%">' +
          '<span class="fdot"></span>' +
          '<span class="fchip">' + chipText + '</span>' +
          '</button>';
      } else if (type === 'fluid') {
        const pos = FOL_POS.fluid;
        const fl = choices.fluidCycle;
        const hasFluid = fl && fl !== 'ندارد';
        const chipText = 'مایع رحم: ' + (fl || 'ندارد');
        return '<button type="button" class="fmarker' + (hasFluid ? ' active' : '') + '" data-type="fluid" style="left:' + pos.x + '%;top:' + pos.y + '%">' +
          '<span class="fdot"></span>' +
          '<span class="fchip">' + chipText + '</span>' +
          '</button>';
      }
      return '';
    }

    function autoDominant() {
      const r = sizes.rightFollicle, l = sizes.leftFollicle;
      const rEligible = r != null && !anov.right;
      const lEligible = l != null && !anov.left;

      if (rEligible && lEligible) {
        if (r > l) return 'راست';
        if (l > r) return 'چپ';
        return 'مشخص نیست';
      }
      if (rEligible) return 'راست';
      if (lEligible) return 'چپ';
      return 'مشخص نیست';
    }

    function renderQuickCardsHTML() {
      // Right Ovary
      const rVal = sizes.rightFollicle;
      const rAnov = anov.right;
      const rCL = clState.right;
      const rDom = choices.dominantSide === 'راست' && !rAnov;
      let rSub = rVal != null ? fa(rVal) + ' میلی‌متر' : 'ثبت نشده';
      let rTag = '';
      if (rAnov) rTag = '<span class="quickCardTag">هموراژیک</span>';
      else if (rDom) rTag = '<span class="quickCardTag">★ غالب</span>';
      else if (rCL && rCL.observed) rTag = '<span class="quickCardTag">CL ' + fa(rCL.size || 20) + '</span>';

      // Left Ovary
      const lVal = sizes.leftFollicle;
      const lAnov = anov.left;
      const lCL = clState.left;
      const lDom = choices.dominantSide === 'چپ' && !lAnov;
      let lSub = lVal != null ? fa(lVal) + ' میلی‌متر' : 'ثبت نشده';
      let lTag = '';
      if (lAnov) lTag = '<span class="quickCardTag">هموراژیک</span>';
      else if (lDom) lTag = '<span class="quickCardTag">★ غالب</span>';
      else if (lCL && lCL.observed) lTag = '<span class="quickCardTag">CL ' + fa(lCL.size || 20) + '</span>';

      // Edema
      const ed = choices.edemaCycle;
      const hasEd = ed && ed !== 'بدون ادم' && ed !== '۰';
      let edSub = ed || 'ثبت نشده';
      let edTag = hasEd ? '<span class="quickCardTag">ثبت شد</span>' : '';

      // Fluid
      const fl = choices.fluidCycle;
      const hasFl = fl && fl !== 'ندارد';
      let flSub = fl || 'ندارد';
      let flTag = hasFl ? '<span class="quickCardTag">ثبت شد</span>' : '';

      const rClasses = 'quickCard' + (rVal != null ? ' active' : '') + (rDom ? ' dom' : '') + (rAnov ? ' anov' : '');
      const lClasses = 'quickCard' + (lVal != null ? ' active' : '') + (lDom ? ' dom' : '') + (lAnov ? ' anov' : '');
      const edClasses = 'quickCard' + (hasEd ? ' active' : '');
      const flClasses = 'quickCard' + (hasFl ? ' active' : '');

      return '<button type="button" class="' + rClasses + '" data-quick="right">' +
        '<div class="quickCardInfo">' +
          '<span class="quickCardTitle">تخمدان راست</span>' +
          '<span class="quickCardVal">' + rSub + '</span>' +
        '</div>' +
        rTag +
        '</button>' +
        '<button type="button" class="' + lClasses + '" data-quick="left">' +
        '<div class="quickCardInfo">' +
          '<span class="quickCardTitle">تخمدان چپ</span>' +
          '<span class="quickCardVal">' + lSub + '</span>' +
        '</div>' +
        lTag +
        '</button>' +
        '<button type="button" class="' + edClasses + '" data-quick="edema">' +
        '<div class="quickCardInfo">' +
          '<span class="quickCardTitle">ادم رحم</span>' +
          '<span class="quickCardVal">' + edSub + '</span>' +
        '</div>' +
        edTag +
        '</button>' +
        '<button type="button" class="' + flClasses + '" data-quick="fluid">' +
        '<div class="quickCardInfo">' +
          '<span class="quickCardTitle">مایع رحم</span>' +
          '<span class="quickCardVal">' + flSub + '</span>' +
        '</div>' +
        flTag +
        '</button>';
    }

    function bindQuickCards(container) {
      const el = container.id === 'quickAccess' ? container : (container.querySelector('#quickAccess') || container);
      if (!el) return;
      el.querySelectorAll('[data-quick]').forEach(b => {
        b.onclick = () => {
          const type = b.dataset.quick;
          const w = document.getElementById('anatomy');
          if (type === 'right' || type === 'left') {
            follicleSide = type;
            sheetKey = follicleSide + 'Follicle';
            anovOn = anov[follicleSide];
            refreshAllAnatomyMarkers();
            buildPopover(w, 'تخمدان ' + (follicleSide === 'right' ? 'راست' : 'چپ'), true);
            openPopover();
          } else if (type === 'edema') {
            sheetKey = 'edema';
            follicleSide = null;
            buildPopover(w, 'ادم رحم', false);
            openPopover();
          } else if (type === 'fluid') {
            sheetKey = 'fluid';
            follicleSide = null;
            buildPopover(w, 'مایع داخل رحم', false);
            openPopover();
          }
        };
      });
    }

    function syncDominantFromSize() {
      // Exclude hemorrhagic follicles from dominant side
      if (choices.dominantSide === 'راست' && anov.right) {
        dominantManual = false;
      }
      if (choices.dominantSide === 'چپ' && anov.left) {
        dominantManual = false;
      }

      if (!dominantManual) {
        const auto = autoDominant();
        if (auto) choices.dominantSide = auto;
        else delete choices.dominantSide;
      }
      const domSec = document.getElementById('domSection');
      if (domSec) {
        domSec.innerHTML = renderDominantHTML();
        bindDomOpts(domSec);
      }
      const quickSec = document.getElementById('quickAccess');
      if (quickSec) {
        quickSec.innerHTML = renderQuickCardsHTML();
        bindQuickCards(quickSec);
      }
      const wrap = document.getElementById('anatomy');
      if (!wrap) return;
      wrap.querySelectorAll('.fmarker[data-type="follicle"]').forEach(m => {
        const isDom = (m.dataset.side === 'right' && choices.dominantSide === 'راست' && !anov.right)
          || (m.dataset.side === 'left' && choices.dominantSide === 'چپ' && !anov.left);
        m.classList.toggle('dom', !!isDom);
      });
    }

    function renderFollicles(card, step) {
      if (!dominantManual) {
        const auto = autoDominant();
        if (auto) choices.dominantSide = auto;
      }

      const lay = document.createElement('div');
      lay.className = 'folliclesLayout';

      const imgWrap = document.createElement('div');
      imgWrap.className = 'anatomyWrap';
      imgWrap.id = 'anatomy';
      imgWrap.innerHTML = '<img src="' + ANATOMY_IMG + '" alt="آناتومی دستگاه تولیدمثل مادیان">' +
        markerHTML('follicle', 'right') +
        markerHTML('follicle', 'left') +
        markerHTML('edema') +
        markerHTML('fluid');
      lay.appendChild(imgWrap);

      const quickSec = document.createElement('div');
      quickSec.className = 'quickAccessGrid';
      quickSec.id = 'quickAccess';
      quickSec.innerHTML = renderQuickCardsHTML();
      lay.appendChild(quickSec);
      bindQuickCards(quickSec);

      const domSec = document.createElement('div');
      domSec.className = 'domSection';
      domSec.id = 'domSection';
      domSec.innerHTML = renderDominantHTML();
      lay.appendChild(domSec);

      bindDomOpts(domSec);
      card.appendChild(lay);
      attachMarkers(imgWrap);
      syncDominantFromSize();
    }

    function renderDominantHTML() {
      const cur = choices.dominantSide;
      const auto = !dominantManual && cur;
      const rDisabled = !!anov.right;
      const lDisabled = !!anov.left;

      let rBtn = '<button type="button" class="' + (cur === 'راست' ? 'active' : '') + '" data-dom="راست"' + (rDisabled ? ' disabled title="فولیکول هموراژیک نمی‌تواند غالب باشد"' : '') + '>راست' + (rDisabled ? ' (هموراژیک)' : '') + '</button>';
      let lBtn = '<button type="button" class="' + (cur === 'چپ' ? 'active' : '') + '" data-dom="چپ"' + (lDisabled ? ' disabled title="فولیکول هموراژیک نمی‌تواند غالب باشد"' : '') + '>چپ' + (lDisabled ? ' (هموراژیک)' : '') + '</button>';
      let unkBtn = '<button type="button" class="' + (cur === 'مشخص نیست' ? 'active' : '') + '" data-dom="مشخص نیست">مشخص نیست</button>';

      return '<div class="domHead"><span>فولیکول غالب</span>' + (auto ? '<span class="autoTag">تعیین خودکار</span>' : '') + '</div>' +
        '<div class="domPills">' + rBtn + lBtn + unkBtn + '</div>';
    }

    function bindDomOpts(container) {
      const el = container.id === 'domSection' ? container : (container.querySelector('#domSection') || container);
      el.querySelectorAll('[data-dom]').forEach(b => {
        b.onclick = ev => {
          ev.stopPropagation();
          if (b.disabled) return;
          dominantManual = true;
          choices.dominantSide = b.dataset.dom;
          el.innerHTML = renderDominantHTML();
          bindDomOpts(el);
          syncDominantFromSize();
        };
      });
    }

    function attachMarkers(wrap) {
      wrap.querySelectorAll('.fmarker').forEach(b => {
        b.onclick = () => {
          const type = b.dataset.type;
          const w = document.getElementById('anatomy');
          if (type === 'follicle') {
            follicleSide = b.dataset.side;
            sheetKey = follicleSide + 'Follicle';
            anovOn = anov[follicleSide];
            refreshAllAnatomyMarkers();
            buildPopover(w, 'تخمدان ' + (follicleSide === 'right' ? 'راست' : 'چپ'), true);
            openPopover();
          } else if (type === 'edema') {
            sheetKey = 'edema';
            follicleSide = null;
            buildPopover(w, 'ادم رحم', false);
            openPopover();
          } else if (type === 'fluid') {
            sheetKey = 'fluid';
            follicleSide = null;
            buildPopover(w, 'مایع داخل رحم', false);
            openPopover();
          }
        };
      });
    }

    function refreshAllAnatomyMarkers() {
      const wrap = document.getElementById('anatomy');
      if (!wrap) return;
      wrap.querySelectorAll('.fmarker').forEach(el => el.remove());
      const html = markerHTML('follicle', 'right') +
        markerHTML('follicle', 'left') +
        markerHTML('edema') +
        markerHTML('fluid');
      wrap.insertAdjacentHTML('beforeend', html);
      attachMarkers(wrap);
      syncDominantFromSize();
    }

    function drawFollicleMarker(v) {
      const wrap = document.getElementById('anatomy');
      if (!wrap || !follicleSide) return;
      const marker = wrap.querySelector('.fmarker[data-type="follicle"][data-side="' + follicleSide + '"]');
      if (!marker) return;
      const key = follicleSide + 'Follicle';
      if (v > 0) sizes[key] = v; else delete sizes[key];
      const label = follicleSide === 'right' ? 'تخمدان راست' : 'تخمدان چپ';
      let foll = marker.querySelector('.ffollicle');
      if (v > 0) {
        if (!foll) {
          foll = document.createElement('span');
          foll.className = 'ffollicle';
          marker.insertBefore(foll, marker.querySelector('.fdot'));
        }
        foll.style.width = fpx(v) + 'px';
        foll.style.height = fpx(v) + 'px';
        foll.textContent = fa(v);
      } else if (foll) {
        foll.remove();
      }
      const chip = marker.querySelector('.fchip');
      if (chip) {
        let chipText = label + (v > 0 ? ' · ' + fa(v) + 'mm' : '');
        if (anov[follicleSide]) chipText += ' (هموراژیک)';
        const clInfo = clState[follicleSide];
        if (clInfo && clInfo.observed) chipText += ' | CL' + (clInfo.size ? ' ' + fa(clInfo.size) + 'mm' : '');
        chip.textContent = chipText;
      }
    }

    function renderImages(card) {
      const up = document.createElement('div'); up.className = 'uploadBox';
      const inp = document.createElement('input');
      inp.type = 'file'; inp.accept = 'image/*'; inp.multiple = true; inp.id = 'upload-main';
      inp.onchange = () => handleImages(inp.files);
      const lbl = document.createElement('label'); lbl.className = 'uploadBtn'; lbl.setAttribute('for', 'upload-main');
      lbl.textContent = '📷 انتخاب عکس‌های سونوگرافی';
      const help = document.createElement('div'); help.className = 'uploadHelp'; help.textContent = 'امکان انتخاب چند عکس هم‌زمان وجود دارد.';
      const count = document.createElement('div'); count.className = 'imageCount'; count.id = 'count-main';
      const grid = document.createElement('div'); grid.className = 'imagePreviewGrid'; grid.id = 'grid-main';
      up.appendChild(inp); up.appendChild(lbl); up.appendChild(help);
      card.appendChild(up);
      card.appendChild(count); card.appendChild(grid);
      refreshImages();
    }
    function refreshImages() {
      const imgs = ultrasoundImages[currentReason] || [];
      const count = document.getElementById('count-main');
      const grid = document.getElementById('grid-main');
      if (!count || !grid) return;
      count.textContent = imgs.length ? fa(imgs.length) + ' عکس اضافه شده است.' : 'هنوز عکسی اضافه نشده است.';
      grid.innerHTML = imgs.map((img, i) =>
        '<div class="imageItem"><img src="' + img.data + '"><button class="imageRemove" type="button" onclick="removeImage(' + i + ')">×</button></div>'
      ).join('');
    }
    function handleImages(fileList) {
      const list = Array.from(fileList || []);
      list.forEach(file => {
        if (!file.type.startsWith('image/')) return;
        const reader = new FileReader();
        reader.onload = e => {
          ultrasoundImages[currentReason].push({ name: file.name, type: file.type, data: e.target.result });
          refreshImages();
        };
        reader.readAsDataURL(file);
      });
      document.getElementById('upload-main').value = '';
    }
    function removeImage(i) {
      ultrasoundImages[currentReason].splice(i, 1);
      refreshImages();
    }

    function renderNote(card) {
      stopVoice();
      const ta = document.createElement('textarea');
      ta.id = 'doctorNote';
      ta.placeholder = 'یادداشت تکمیلی را بنویسید یا دکمه میکروفون را بزنید...';
      ta.value = fields.doctorNote || '';
      ta.oninput = () => { fields.doctorNote = ta.value; };
      card.appendChild(ta);
      const bar = document.createElement('div');
      bar.className = 'voiceBar';
      bar.innerHTML =
        '<button type="button" class="voiceBtn" id="voiceBtn"><span class="micDot"></span>تبدیل صدا به متن</button>' +
        '<span class="voiceHint" id="voiceHint">فارسی • رایگان در مرورگر (Chrome / Edge / Safari)</span>' +
        '<div class="voiceLive" id="voiceLive"></div>';
      card.appendChild(bar);
      document.getElementById('voiceBtn').onclick = voiceInput;
    }

    function renderSummary(card) {
      const pre = document.createElement('div');
      pre.className = 'preview';
      pre.id = 'summaryPreview';
      pre.textContent = getReportText();
      card.appendChild(pre);
      const imgs = ultrasoundImages[currentReason] || [];
      if (imgs.length) {
        const ri = document.createElement('div'); ri.className = 'reportImages';
        ri.innerHTML = '<div class="reportImageGrid" style="margin-bottom:6px">' + imgs.map(img => '<img src="' + img.data + '">').join('') + '</div>';
        card.appendChild(ri);
      }
      const btns = document.createElement('div');
      btns.className = 'summaryBtns';
      const copy = document.createElement('button'); copy.className = 'ghost'; copy.textContent = '📋 کپی متن'; copy.onclick = copyReport;
      const save = document.createElement('button'); save.className = 'ghost'; save.textContent = '💾 ذخیره موقت'; save.onclick = saveDraft;
      const build = document.createElement('button'); build.className = 'ok'; build.textContent = 'ساخت گزارش نهایی ✓'; build.onclick = finalize;
      btns.appendChild(copy); btns.appendChild(save); btns.appendChild(build);
      card.appendChild(btns);
    }

    /* ================= report ================= */
    function reportCycle() {
      let clSummary = 'مشاهده نشد';
      const rCL = clState.right && clState.right.observed;
      const lCL = clState.left && clState.left.observed;
      if (rCL && lCL) {
        clSummary = 'دوطرفه (راست: ' + (clState.right.size ? clState.right.size + ' میلی‌متر' : 'مشاهده شد') +
          '، چپ: ' + (clState.left.size ? clState.left.size + ' میلی‌متر' : 'مشاهده شد') + ')';
      } else if (rCL) {
        clSummary = 'تخمدان راست (' + (clState.right.size ? clState.right.size + ' میلی‌متر' : 'مشاهده شد') + ')';
      } else if (lCL) {
        clSummary = 'تخمدان چپ (' + (clState.left.size ? clState.left.size + ' میلی‌متر' : 'مشاهده شد') + ')';
      }

      const rFollDesc = size('rightFollicle') + (anov.right ? ' [هموراژیک / غیرطبیعی]' : '');
      const lFollDesc = size('leftFollicle') + (anov.left ? ' [هموراژیک / غیرطبیعی]' : '');

      let fluidStr = choices.fluidCycle || 'ندارد';
      if (fluidStr !== 'ندارد' && fields.fluidEcho) {
        fluidStr += ' (' + fields.fluidEcho + ')';
      }

      return 'نوع ویزیت: بررسی سیکل / زمان تلقیح\nوضعیت سیکل: ' + active('cycleStage') +
        '\nآخرین تلقیح/جفت‌گیری: ' + val('lastBreedingDate') + ' - روش: ' + active('breedingMethod') +
        '\nتخمدان راست: بزرگ‌ترین فولیکول ' + rFollDesc + (rCL ? ' • دارای CL' : '') +
        '\nتخمدان چپ: بزرگ‌ترین فولیکول ' + lFollDesc + (lCL ? ' • دارای CL' : '') +
        '\nفولیکول غالب: ' + active('dominantSide') +
        '\nجسم زرد (CL): ' + clSummary +
        '\nرحم: ادم درجه ' + (choices.edemaCycle || 'ثبت نشده') + '؛ مایع داخل رحم: ' + fluidStr +
        '\nسرویکس: ' + active('cervixCycle') +
        '\nبرآورد زمان تخمک‌گذاری: ' + active('ovEstimate') +
        '\nاقدام پیشنهادی: ' + active('cycleAction');
    }

    function reportOvulation() {
      let extra = active('ovResult') === 'تخمک‌گذاری انجام شده'
        ? '\nشواهد حمایتی: ' + multi('ovSigns') + '\nسمت تخمک‌گذاری: ' + active('ovSide') : '';
      return 'نوع ویزیت: بررسی تخمک‌گذاری\nآخرین کنترل: ' + val('lastScan') +
        '\nتخمدان راست قبلی: بزرگ‌ترین فولیکول ' + size('rightFollicle') +
        '\nتخمدان چپ قبلی: بزرگ‌ترین فولیکول ' + size('leftFollicle') +
        '\nفولیکول غالب قبلی: ' + active('dominantSide') +
        '\nنتیجه بررسی: ' + active('ovResult') + extra +
        '\nبرنامه بعدی: ' + active('ovAction');
    }

    function reportPregnancy() {
      const s = active('pregStatus');
      let details = '';
      if (s === 'مشاهده شد') {
        details = '\nتعداد وزیکول‌ها: ' + active('vesicleCount') +
          '\nاندازه وزیکول اصلی: ' + size('vesicleSize') +
          '\nمحل: ' + active('pregLocation') +
          '\nEmbryo/Fetal pole: ' + active('embryoStatus');
        if (active('embryoStatus') === 'مشاهده شد') details += '\nضربان قلب: ' + active('heartbeat');
        details += '\nظاهر کلی آبستنی: ' + active('pregAppearance');
      } else if (s !== 'ثبت نشده') {
        details = '\nرحم: ' + active('pregUterus') + '\nCL: ' + active('pregCL');
      }
      return 'نوع ویزیت: بررسی آبستنی\nروز پس از تلقیح/جفت‌گیری: ' + (val('daysPostBreeding') === 'ثبت نشده' ? 'ثبت نشده' : val('daysPostBreeding') + ' روز') +
        '\nتاریخ آخرین تلقیح: ' + val('pregBreedingDate') +
        '\nنتیجه سونوگرافی: ' + s + details +
        '\nبرنامه پیگیری: ' + active('pregAction');
    }

    function reportProblem() {
      return 'نوع ویزیت: بررسی مشکل تولیدمثلی\nعلت اصلی: ' + active('problemReason') +
        '\nتاریخچه: ' + val('problemHistory') +
        '\nیافته‌های رحم: ' + multi('uterusProblem') +
        '\nیافته‌های تخمدان: ' + multi('ovaryProblem') +
        '\nسرویکس: ' + active('problemCervix') +
        '\nAssessment: ' + val('problemAssessment') +
        '\nاقدامات پیشنهادی: ' + multi('problemAction');
    }

    function reportOther() {
      return 'نوع ویزیت: سایر\nعلت مراجعه: ' + val('otherReason') +
        '\nیافته‌ها: ' + val('otherFindings') +
        '\nنتیجه / توصیه: ' + val('otherPlan');
    }

    function getReportText() {
      let txt = currentReason === 'cycle' ? reportCycle() :
        currentReason === 'ovulation' ? reportOvulation() :
        currentReason === 'pregnancy' ? reportPregnancy() :
        currentReason === 'problem' ? reportProblem() : reportOther();
      txt = 'BCS مادیان: ' + (bcs ? (bcs === 'ارزیابی نشد' ? 'ارزیابی نشد' : bcs + ' / 9') : 'ثبت نشده') + '\n' + txt;
      const note = fields.doctorNote || '';
      if (note.trim()) txt += '\nیادداشت تکمیلی دامپزشک: ' + note.trim();
      const n = (ultrasoundImages[currentReason] || []).length;
      if (n) txt += '\nتعداد تصاویر سونوگرافی ضمیمه: ' + n;
      return txt;
    }

    /* ================= nav ================= */
    function next() {
      const vis = visibleSteps();
      const i = vis.findIndex(s => s.id === currentId);
      if (i >= 0 && i < vis.length - 1) { currentId = vis[i + 1].id; renderStep(); }
      else if (i === vis.length - 1 && currentId === 'summary') { finalize(); }
    }
    function prev() {
      const vis = visibleSteps();
      const i = vis.findIndex(s => s.id === currentId);
      if (i > 0) { currentId = vis[i - 1].id; renderStep(); }
    }

    function seedFromRecord() {
      currentReason = null;
      currentId = 'bcs';
      follicleSide = null;
      anovOn = false;
      curFollicle = false;
      dominantManual = false;
      sheetKey = null;
      bcs = null;

      anov.right = false;
      anov.left = false;
      clState.right = { observed: false, size: null };
      clState.left = { observed: false, size: null };

      Object.keys(choices).forEach(k => delete choices[k]);
      choices.breedingMethod = RECORD.breedingMethod;
      choices.fluidCycle = 'ندارد';

      Object.keys(multis).forEach(k => delete multis[k]);
      Object.keys(fields).forEach(k => delete fields[k]);
      Object.assign(fields, {
        lastScan: RECORD.lastScan,
        lastBreedingDate: RECORD.lastBreedingDate,
        pregBreedingDate: RECORD.lastBreedingDate,
        daysPostBreeding: RECORD.daysPostBreeding,
        prevMethod: RECORD.prevMethod,
        prevFollicleNote: RECORD.prevFollicleNote,
        problemHistory: RECORD.problemHistory,
        fluidEcho: ''
      });
      Object.keys(sizes).forEach(k => delete sizes[k]);
      Object.keys(dates).forEach(k => delete dates[k]);
      Object.assign(dates, {
        lastBreedingDate: RECORD.lastBreeding ? Object.assign({}, RECORD.lastBreeding) : null,
        pregBreedingDate: RECORD.lastBreeding ? Object.assign({}, RECORD.lastBreeding) : null
      });
      Object.keys(ultrasoundImages).forEach(k => { ultrasoundImages[k] = []; });
      const bn = document.getElementById('branchName');
      if (bn) bn.textContent = 'فرم تطبیقی سونوگرافی مادیان';
    }

    function resetForm() {
      if (!confirm('آیا از بازنشانی و پاک کردن اطلاعات فرم اطمینان دارید؟')) return;
      stopVoice();
      seedFromRecord();
      renderStep();
      toast('فرم از ابتدا شروع شد');
    }
    function finalize() {
      const p = document.getElementById('summaryPreview');
      if (p) p.textContent = getReportText();
      document.getElementById('progressBar').style.width = '100%';
      toast('گزارش نهایی ساخته شد');
    }
    function copyReport() {
      const t = getReportText();
      const done = () => toast('متن گزارش کپی شد');
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(t).then(done).catch(() => fallbackCopy());
      } else fallbackCopy();
    }
    function fallbackCopy() {
      const ta = document.createElement('textarea');
      ta.value = getReportText();
      ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      document.execCommand('copy'); ta.remove();
      toast('متن گزارش کپی شد');
    }
    function saveDraft() {
      try {
        const state = { reason: currentReason, bcs, choices, multis, fields, sizes, dates, anov, clState, images: ultrasoundImages, time: new Date().toISOString() };
        localStorage.setItem('equibook_onehand_v4', JSON.stringify(state));
        toast('فرم موقتاً روی این دستگاه ذخیره شد');
      } catch (e) {
        toast('حجم تصاویر زیاد است؛ گزارش را نهایی کنید');
      }
    }

    /* ================= voice (Web Speech API, fa-IR) ================= */
    let rec = null;
    let recOn = false;

    function stopVoice() {
      if (rec) {
        try { rec.onend = null; rec.stop(); } catch (e) {}
      }
      rec = null;
      recOn = false;
      const btn = document.getElementById('voiceBtn');
      const hint = document.getElementById('voiceHint');
      const live = document.getElementById('voiceLive');
      if (btn) btn.classList.remove('recording');
      if (hint) hint.textContent = 'فارسی • رایگان در مرورگر (Chrome / Edge / Safari)';
      if (live) { live.classList.remove('show'); live.textContent = ''; }
    }

    function voiceInput() {
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SR) {
        toast('این مرورگر تشخیص گفتار را پشتیبانی نمی‌کند');
        return;
      }
      if (recOn) { stopVoice(); toast('ضبط متوقف شد'); return; }

      const ta = document.getElementById('doctorNote');
      const btn = document.getElementById('voiceBtn');
      const hint = document.getElementById('voiceHint');
      const live = document.getElementById('voiceLive');
      if (!ta) return;

      rec = new SR();
      rec.lang = 'fa-IR';
      rec.interimResults = true;
      rec.continuous = true;
      rec.maxAlternatives = 1;

      const base = ta.value;
      let finals = '';

      rec.onstart = () => {
        recOn = true;
        if (btn) btn.classList.add('recording');
        if (hint) hint.textContent = 'در حال شنیدن فارسی… دوباره بزنید برای توقف';
      };
      rec.onresult = e => {
        let interim = '';
        for (let i = e.resultIndex; i < e.results.length; i++) {
          const t = e.results[i][0].transcript.trim();
          if (!t) continue;
          if (e.results[i].isFinal) finals += (finals ? ' ' : '') + t;
          else interim += (interim ? ' ' : '') + t;
        }
        const extra = [finals, interim].filter(Boolean).join(' ');
        ta.value = [base.replace(/\s+$/, ''), extra].filter(Boolean).join(base.trim() ? ' ' : '');
        fields.doctorNote = ta.value;
        if (live) {
          if (interim) { live.textContent = interim; live.classList.add('show'); }
          else { live.classList.remove('show'); live.textContent = ''; }
        }
      };
      rec.onerror = e => {
        if (e.error === 'not-allowed' || e.error === 'service-not-allowed') toast('دسترسی میکروفون داده نشد');
        else if (e.error === 'no-speech') toast('صدایی شنیده نشد');
        else if (e.error === 'audio-capture') toast('میکروفون پیدا نشد');
        else if (e.error !== 'aborted') toast('خطای تشخیص گفتار');
      };
      rec.onend = () => {
        const wasOn = recOn;
        recOn = false;
        rec = null;
        if (btn) btn.classList.remove('recording');
        if (hint) hint.textContent = 'فارسی • رایگان در مرورگر (Chrome / Edge / Safari)';
        if (live) { live.classList.remove('show'); live.textContent = ''; }
        if (wasOn && finals) toast('متن صوتی اضافه شد');
      };
      try { rec.start(); }
      catch (err) { toast('شروع ضبط ممکن نشد'); stopVoice(); }
    }

    /* ================= init ================= */
    renderStep();
  </script>
</body>
</html>