<!doctype html>
<html lang="fa" dir="rtl">

<head>
  <meta name="robots" content="noindex, nofollow">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
  <title>گزارش هوشمند مامایی</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;700;800&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --green: #1f6049;
      --green2: #edf7f2;
      --green3: #d8eee3;
      --gold: #b9831d;
      --gold2: #fff7e8;
      --red: #b74c4c;
      --red2: #fff1f1;
      --blue: #3d6fa6;
      --blue2: #eef5ff;
      --ink: #1b1b1b;
      --muted: #777;
      --line: #e9e9e9;
      --bg: #f6f6f3;
      --card: #fff;
    }

    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent }
    html { scroll-behavior: smooth }

    body {
      margin: 0;
      background: #e9e9e6;
      font-family: 'Vazirmatn', Tahoma, Arial, sans-serif;
      color: var(--ink);
      overscroll-behavior-y: none;
    }

    button, input, textarea, select { font: inherit; font-family: inherit }
    button { cursor: pointer; touch-action: manipulation; user-select: none }
    button, a, input, textarea, select { -webkit-user-select: none }

    .app {
      min-height: 100vh;
      background: var(--bg);
      padding-bottom: 96px;
    }

    /* ---------- header ---------- */
    header {
      position: sticky; top: 0; z-index: 30; background: #fff;
      padding: 10px 14px; box-shadow: 0 2px 14px #0000000c;
    }
    header .head, header .progress { max-width: 680px; margin-left: auto; margin-right: auto }
    .head { display: flex; align-items: center; gap: 10px }
    .back { width: 42px; height: 42px; border: 0; border-radius: 13px; background: #f1f2ef; font-size: 24px; line-height: 1 }
    .title { flex: 1; min-width: 0 }
    .title h1 { font-size: 16px; margin: 0 0 2px; font-weight: 800 }
    .title p { font-size: 10px; color: #777; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis }
    .logo { font: bold 19px Georgia, serif; color: var(--green); direction: ltr }
    .progress { height: 5px; background: #ececea; border-radius: 99px; margin-top: 10px; overflow: hidden }
    .progress > span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--green), #3b8a6d); border-radius: 99px; transition: width .25s }

    /* ---------- step area ---------- */
    main { max-width: 680px; margin: 0 auto; padding: 10px }
    .step { animation: fade .22s ease }
    @keyframes fade { from { opacity: 0; transform: translateY(8px) } to { opacity: 1; transform: none } }

    .topline { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px }
    .counter { display: inline-flex; align-items: center; gap: 7px; background: var(--green2); color: var(--green); border-radius: 99px; padding: 6px 13px; font-size: 11px; font-weight: 700 }
    .counter .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green) }

    .card { background: var(--card); border-radius: 22px; padding: 12px 14px; box-shadow: 0 3px 15px #00000008 }
    .card h2 { font-size: 17px; margin: 0 0 2px; line-height: 1.35; font-weight: 800 }
    .card .sub { font-size: 10.5px; color: #7c7c7c; line-height: 1.6; margin: 0 0 8px }

    /* ---------- choice buttons ---------- */
    .opts { display: flex; flex-direction: column; gap: 8px }
    .opt {
      border: 1.5px solid var(--line); background: #fff; border-radius: 12px;
      min-height: 44px; padding: 8px 12px; font-size: 12.5px; text-align: right;
      transition: .12s; display: flex; align-items: center; justify-content: space-between; gap: 8px; width: 100%;
    }
    .opt .chk { width: 20px; height: 20px; border-radius: 50%; border: 1.5px solid #d5d5d5; flex: none; display: grid; place-items: center; font-size: 12px; color: transparent; transition: .12s }
    .opt:active { transform: scale(.98) }
    .opt.active { border: 2px solid var(--green); background: var(--green2); color: var(--green); font-weight: 700 }
    .opt.active .chk { background: var(--green); border-color: var(--green); color: #fff }
    .opt.red.active { border-color: var(--red); background: var(--red2); color: var(--red) }
    .opt.red.active .chk { background: var(--red); border-color: var(--red) }
    .opt.gold.active { border-color: var(--gold); background: var(--gold2); color: #916511 }
    .opt.gold.active .chk { background: var(--gold); border-color: var(--gold) }
    .opt.blue.active { border-color: var(--blue); background: var(--blue2); color: var(--blue) }
    .opt.blue.active .chk { background: var(--blue); border-color: var(--blue) }

    .scale { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px }
    .scale button { height: 62px; border: 1.5px solid var(--line); border-radius: 16px; background: #fff; font-size: 21px; font-weight: 700; color: #444; transition: .12s }
    .scale button:active { transform: scale(.95) }
    .scale button.active { background: var(--green); border-color: var(--green); color: #fff; box-shadow: 0 4px 12px #1f604940 }

    /* fields */
    .field { margin-bottom: 14px }
    .field label { display: block; font-size: 12px; color: #555; margin-bottom: 7px; font-weight: 700 }
    input, select, textarea { width: 100%; border: 1.5px solid var(--line); border-radius: 15px; background: #fff; padding: 14px; font-size: 14px; outline: 0; color: var(--ink) }
    input:focus, select:focus, textarea:focus { border-color: var(--green) }
    textarea { min-height: 110px; resize: none; line-height: 1.9; -webkit-user-select: text; user-select: text }
    .unitwrap { position: relative }
    .unitwrap input { padding-left: 48px }
    .unitwrap .u { position: absolute; left: 14px; top: 14px; color: #888; font-size: 11px }

    /* ---------- Shamsi date picker ---------- */
    .dateField {
      width: 100%; border: 1.5px solid var(--line); border-radius: 14px; background: #fff;
      padding: 11px 12px; font-size: 13.5px; text-align: right; color: var(--ink); display: flex; align-items: center; gap: 8px;
    }
    .dateField.empty { color: #999 }
    .dateField .calIco { font-size: 16px; flex: none }
    .calWrap { margin-top: 8px; border: 1.5px solid var(--line); border-radius: 16px; overflow: hidden; background: #fff; animation: popIn .2s ease }
    @keyframes popIn { from { opacity: 0; transform: translateY(-6px) } to { opacity: 1; transform: none } }

    /* iOS-style year / month / day wheels */
    .iosPicker {
      position: relative; display: flex; direction: rtl;
      height: 126px; margin: 2px 0 0; background: #fff;
    }
    .iosCol {
      flex: 1; min-width: 0; overflow-y: auto; overscroll-behavior: contain;
      scroll-snap-type: y mandatory; -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .iosCol::-webkit-scrollbar { display: none }
    .iosItem, .iosPad { height: 36px; flex: none }
    .iosPad { pointer-events: none }
    .iosItem {
      scroll-snap-align: center; display: flex; align-items: center; justify-content: center;
      font-size: 15px; font-weight: 600; color: #9a9a9a; transition: color .12s, transform .12s;
    }
    .iosItem.on { color: var(--ink); font-weight: 800; transform: scale(1.06) }
    .iosHi {
      position: absolute; left: 8px; right: 8px; top: 50%; height: 36px;
      transform: translateY(-50%); border-radius: 10px;
      background: rgba(31, 96, 73, .08); pointer-events: none; z-index: 1;
    }
    .iosFade {
      position: absolute; left: 0; right: 0; height: 40px; z-index: 2; pointer-events: none;
    }
    .iosFadeT { top: 0; background: linear-gradient(#fff, #ffffff00) }
    .iosFadeB { bottom: 0; background: linear-gradient(#ffffff00, #fff) }
    .iosLabs {
      display: flex; direction: rtl; padding: 6px 6px 0; font-size: 9.5px; font-weight: 700; color: #8aa697;
    }
    .iosLabs span { flex: 1; text-align: center }

    .calGrid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; padding: 6px 8px 2px }
    .calGrid .dow { text-align: center; font-size: 9px; color: #999; padding: 1px 0 3px; font-weight: 700 }
    .calGrid .day {
      height: 30px; display: grid; place-items: center; border: 0; background: transparent;
      border-radius: 8px; font-size: 12px; color: #333;
    }
    .calGrid .day:active { background: #eef2ef }
    .calGrid .day.today { color: var(--green); font-weight: 800 }
    .calGrid .day.sel { background: var(--green); color: #fff; font-weight: 800 }
    .calFoot { display: flex; gap: 8px; padding: 6px 8px 8px }
    .calFoot button { flex: 1; min-height: 40px; border-radius: 12px; font-size: 13px; font-weight: 700 }
    .calToday { border: 1.5px solid var(--green3); background: var(--green2); color: var(--green) }
    .confirmBtn { border: 0; background: var(--green); color: #fff }

    /* ---------- anatomy image + markers ---------- */
    .folliclesLayout { display: block }
    .anatomyWrap {
      position: relative; width: 100%;
      border: 0; border-radius: 16px; overflow: hidden; background: #fff;
    }
    .anatomyWrap > img { width: 100%; height: auto; display: block }
    .fmarker {
      position: absolute; transform: translate(-50%, -50%);
      width: 58px; height: 58px; border: 0; padding: 0; z-index: 3;
      border-radius: 50%; display: grid; place-items: center;
      background: rgba(31, 96, 73, .10);
      box-shadow: inset 0 0 0 1.5px rgba(31, 96, 73, .28);
    }
    .fmarker.sel {
      background: rgba(185, 131, 29, .14);
      box-shadow: inset 0 0 0 1.5px rgba(185, 131, 29, .5);
    }
    .fmarker.dom:not(.sel) {
      background: rgba(31, 96, 73, .16);
      box-shadow: inset 0 0 0 2px rgba(31, 96, 73, .55);
    }
    .fmarker .fdot {
      width: 13px; height: 13px; border-radius: 50%;
      background: rgba(31, 96, 73, .92);
      box-shadow: 0 0 0 0 rgba(31, 96, 73, .55);
      animation: pulse 1.7s infinite; transition: .15s;
    }
    .fmarker.sel .fdot { background: #b9831d; transform: scale(1.18); animation: pulseGold 1.7s infinite }
    @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(31, 96, 73, .5) } 70% { box-shadow: 0 0 0 13px rgba(31, 96, 73, 0) } 100% { box-shadow: 0 0 0 0 rgba(31, 96, 73, 0) } }
    @keyframes pulseGold { 0% { box-shadow: 0 0 0 0 rgba(185, 131, 29, .5) } 70% { box-shadow: 0 0 0 13px rgba(185, 131, 29, 0) } 100% { box-shadow: 0 0 0 0 rgba(185, 131, 29, 0) } }
    .fchip {
      position: absolute; top: calc(100% - 11px); left: 50%; transform: translateX(-50%);
      background: #fff; color: var(--ink); font-size: 9px; font-weight: 700; border-radius: 99px;
      padding: 3px 8px; white-space: nowrap; z-index: 4;
      box-shadow: 0 2px 8px #00000022;
    }
    .fmarker[data-side="left"] .fchip { left: 8px; transform: none }
    .fmarker[data-side="right"] .fchip { left: auto; right: 8px; transform: none }
    .fmarker.sel .fchip { background: var(--gold); color: #fff }
    .ffollicle {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); border-radius: 50%;
      background: radial-gradient(circle at 34% 30%, #414149, #0d0d11); border: 2px solid rgba(255, 255, 255, .4);
      display: grid; place-items: center; color: #fff; font-size: 11px; font-weight: 700;
      pointer-events: none; z-index: 2; transition: width .12s, height .12s;
    }

    /* dominant follicle — borderless overlay on the anatomy image */
    .domOverlay {
      position: absolute; left: 10px; right: 10px; bottom: 10px; z-index: 5;
      background: rgba(255, 255, 255, .82);
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      border: 0; border-radius: 14px; padding: 8px 10px 9px;
      box-shadow: 0 8px 22px #00000014;
    }
    .domHead {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      margin: 0 0 7px; padding: 0; border: 0;
      font-size: 12px; font-weight: 800; color: var(--ink);
    }
    .domHead .autoTag {
      font-size: 8.5px; font-weight: 700; color: var(--green);
      background: var(--green2); border-radius: 99px; padding: 2px 7px;
    }
    .domPills { display: flex; gap: 6px }
    .domPills button {
      flex: 1; min-height: 36px; border: 0; border-radius: 11px;
      background: rgba(246, 246, 243, .92); color: #333;
      font-size: 12px; font-weight: 700; padding: 0 6px;
    }
    .domPills button.active { background: var(--green); color: #fff }

    /* ---------- single follicle SVG ---------- */
    .follicleWrap { position: relative; border: 1.5px dashed #bfd8ca; background: #f8fcfa; border-radius: 20px; padding: 10px 12px 6px; text-align: center; cursor: pointer; transition: .12s }
    .follicleWrap:active { transform: scale(.985) }
    .follicleWrap svg { width: 100%; max-width: 300px; height: auto; display: block; margin: 0 auto }
    .follicleVal { margin-top: 12px; text-align: center; font-size: 15px; font-weight: 800; color: var(--green) }
    .follicleVal span { color: #999; font-weight: 500; font-size: 12px }

    /* ---------- size picker: overlay on image ---------- */
    .wrapScrim { position: absolute; inset: 0; background: rgba(20, 20, 20, .18); border-radius: inherit; z-index: 8; opacity: 0; pointer-events: none; transition: .18s }
    .wrapScrim.show { opacity: 1; pointer-events: auto }
    .popover {
      display: none; position: absolute; left: 10px; right: 10px; bottom: 12px; z-index: 9;
      background: #fff; border: 1px solid var(--line); border-radius: 16px;
      padding: 13px 14px 12px; box-shadow: 0 14px 34px #00000040;
    }
    .popover.open { display: block; animation: popUp .2s ease }
    @keyframes popUp { from { opacity: 0; transform: translateY(10px) } to { opacity: 1; transform: none } }
    .popHead { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px }
    .popHead .lbl { font-size: 11px; color: #888; font-weight: 700 }
    .popValue { text-align: center; font-size: 32px; font-weight: 800; color: var(--green); line-height: 1.1 }
    .popValue small { font-size: 13px; color: #888; font-weight: 500 }
    .stepper { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 8px }
    .stepper .stepBtn { width: 46px; height: 46px; border-radius: 13px; border: 1.5px solid var(--line); background: #fff; font-size: 22px; font-weight: 700; color: var(--green) }
    .stepper .stepBtn:active { background: #eef7f2 }
    .stepper input {
      width: 82px; text-align: center; font-size: 20px; font-weight: 800; color: var(--green);
      border: 1.5px solid var(--line); border-radius: 13px; padding: 9px; background: #fff;
    }
    .stepper input:focus { border-color: var(--green) }
    .stepper .mm { font-size: 13px; color: #888; font-weight: 500 }
    .rangeRow { display: flex; align-items: center; gap: 12px; margin: 8px 0 2px; direction: ltr }
    .rangeRow .min, .rangeRow .max { font-size: 11px; color: #999; flex: none; line-height: 1 }
    input[type=range] { flex: 1; -webkit-appearance: none; appearance: none; height: 32px; background: transparent; padding: 0 }
    input[type=range]::-webkit-slider-runnable-track { height: 8px; border-radius: 99px; background: #e7efe9; margin-top: 12px }
    input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 32px; height: 32px; border-radius: 50%; background: var(--green); border: 4px solid #fff; box-shadow: 0 2px 8px #00000030; margin-top: 0; cursor: pointer }
    input[type=range]::-moz-range-track { height: 8px; border-radius: 99px; background: #e7efe9 }
    input[type=range]::-moz-range-thumb { width: 24px; height: 24px; border-radius: 50%; background: var(--green); border: 4px solid #fff; box-shadow: 0 2px 8px #00000030; cursor: pointer }
    .presets { display: flex; gap: 8px; justify-content: center; margin-top: 8px }
    .presets button { border: 1.5px solid var(--green3); background: var(--green2); color: var(--green); border-radius: 99px; padding: 8px 15px; font-size: 13px; font-weight: 700; min-width: 46px }
    .presets button:active { transform: scale(.93) }
    .popBtns { display: flex; gap: 10px; margin-top: 12px }
    .popBtns button { flex: 1; min-height: 50px; border-radius: 15px; font-size: 14px; font-weight: 700; border: 0 }
    .popBtns .ok { background: var(--green); color: #fff }
    .popBtns .clear { border: 1.5px solid #ddd; background: #fff; color: #777 }

    /* ---------- bottom nav ---------- */
    .nav {
      position: fixed; bottom: 0; left: 0; right: 0; width: 100%; max-width: 680px; margin: 0 auto;
      background: #fff; padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
      display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px;
      box-shadow: 0 -4px 18px #00000015; z-index: 35;
    }
    .nav button {
      min-height: 50px; width: 100%; border-radius: 14px; font-size: 14px; font-weight: 700;
      padding: 0 8px; border: 0; transition: .12s;
    }
    .nav button:active { transform: scale(.97) }
    .nav .prev { border: 1.5px solid #ddd; background: #fff; color: #444 }
    .nav .prev:disabled { opacity: .35; pointer-events: none }
    .nav .reset {
      border: 1.5px solid #ead4d4; background: #fff7f7; color: var(--red);
    }
    .nav .next { background: var(--green); color: #fff }
    .nav .next:disabled { background: #d6d6d3; color: #fff }
    .nav button.ghostSlot { visibility: hidden; pointer-events: none }

    /* upload / note / summary */
    .uploadBox { border: 1.5px dashed #bfd8ca; background: #f8fcfa; border-radius: 18px; padding: 16px; text-align: center }
    .uploadBox input[type=file] { display: none }
    .uploadBtn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 0; background: var(--green2); color: var(--green); border-radius: 14px; padding: 14px 18px; font-size: 13px; font-weight: 700 }
    .uploadHelp { font-size: 10px; color: #777; line-height: 1.8; margin: 10px 0 0 }
    .imagePreviewGrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 14px }
    .imageItem { position: relative; background: #f2f2f2; border-radius: 14px; overflow: hidden; aspect-ratio: 1/1 }
    .imageItem img { width: 100%; height: 100%; object-fit: cover; display: block }
    .imageRemove { position: absolute; top: 6px; left: 6px; width: 28px; height: 28px; border: 0; border-radius: 50%; background: #000a; color: #fff; font-size: 15px; line-height: 28px; padding: 0 }
    .imageCount { font-size: 10px; color: var(--green); margin-top: 10px }

    .voiceBar { display: flex; align-items: center; gap: 10px; margin-top: 12px; flex-wrap: wrap }
    .voiceBtn {
      display: inline-flex; align-items: center; gap: 8px; border: 0; border-radius: 14px;
      background: var(--green2); color: var(--green); padding: 12px 16px; font-size: 13px; font-weight: 700;
    }
    .voiceBtn .micDot { width: 9px; height: 9px; border-radius: 50%; background: var(--green) }
    .voiceBtn.recording { background: var(--red2); color: var(--red) }
    .voiceBtn.recording .micDot { background: var(--red); box-shadow: 0 0 0 0 rgba(183,76,76,.5); animation: pulse 1.2s infinite }
    .voiceHint { font-size: 11px; color: #888; line-height: 1.6 }
    .voiceLive {
      width: 100%; min-height: 0; margin-top: 2px; font-size: 12px; color: var(--green);
      background: var(--green2); border-radius: 12px; padding: 8px 12px; display: none;
    }
    .voiceLive.show { display: block }

    .preview { background: #f2faf5; border: 1px solid #dceee4; color: #2d634e; border-radius: 16px; padding: 14px; font-size: 12px; line-height: 2.1; white-space: pre-wrap; margin-top: 12px }
    .reportImages { margin-top: 12px }
    .reportImageGrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px }
    .reportImageGrid img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 12px; border: 1px solid #e7e7e7; background: #eee }

    .summaryBtns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px }
    .summaryBtns button { flex: 1; min-width: 120px; min-height: 52px; border-radius: 15px; font-size: 14px; font-weight: 700; border: 0 }
    .summaryBtns .ghost { border: 1.5px solid #ddd; background: #fff; color: #555 }
    .summaryBtns .ok { background: var(--green); color: #fff; flex: 2 }

    .recordBanner {
      display: flex; align-items: flex-start; gap: 8px;
      background: #f3f7f5; border-radius: 12px; padding: 8px 10px; margin: 0 0 10px;
      font-size: 10.5px; color: #4a6b5c; line-height: 1.7;
    }
    .recordBanner b { color: var(--green) }
    .recordTag {
      flex: none; font-size: 8.5px; font-weight: 800; color: var(--green);
      background: #fff; border-radius: 99px; padding: 2px 7px; margin-top: 2px;
    }

    .toast { position: fixed; bottom: 90px; left: 50%; transform: translateX(-50%); background: #242424; color: #fff; padding: 11px 18px; border-radius: 14px; font-size: 12px; opacity: 0; transition: .2s; z-index: 60; pointer-events: none }
    .toast.show { opacity: 1 }

    @media (min-width: 720px) {
      .anatomyWrap { max-width: 560px; margin: 0 auto }
    }
  </style>
</head>

<body>
  <div class="app">
    <header>
      <div class="head">
        <button class="back" onclick="history.back()">‹</button>
        <div class="title">
          <h1>گزارش هوشمند مامایی</h1>
          <p id="branchName">فرم تطبیقی سونوگرافی مادیان</p>
        </div>
      </div>
      <div class="progress"><span id="progressBar"></span></div>
    </header>

    <main id="main">
      <div id="step"></div>
    </main>

    <div class="nav" id="nav">
      <button class="prev" id="btnPrev" onclick="prev()">قبلی</button>
      <button class="reset" id="btnReset" onclick="resetForm()">بازنشانی</button>
      <button class="next" id="btnNext" onclick="next()">بعدی</button>
    </div>

    <div class="toast" id="toast"></div>
  </div>

  <script is:inline>
    /* ================= state ================= */
    let currentReason = null;
    let bcs = null;
    let currentId = 'bcs';
    let sheetKey = null;
    let follicleSide = null;
    let anovOn = false;
    let curFollicle = false;
    let dominantManual = false;

    /* demo mare file — later replaced by DB read */
