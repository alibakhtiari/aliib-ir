      const vis = visibleSteps();
      const idx = vis.findIndex(s => s.id === currentId);
      const step = vis[idx];
      const ph = phaseInfo();
      stopVoice();
      const box = document.getElementById('step');
      box.innerHTML = '';
      const wrap = document.createElement('div');
      wrap.className = 'step';
      box.appendChild(wrap);

      const tl = document.createElement('div');
      tl.className = 'topline';
      const counter = document.createElement('span');
      counter.className = 'counter';
      counter.innerHTML = '<span class="dot"></span>سؤال ' + fa(ph.idx + 1) + ' از ' + fa(ph.total);
      tl.appendChild(counter);
      wrap.appendChild(tl);

      const card = document.createElement('div');
      card.className = 'card';
      const h = document.createElement('h2'); h.textContent = step.title; card.appendChild(h);
      if (step.sub) { const s = document.createElement('p'); s.className = 'sub'; s.textContent = step.sub; card.appendChild(s); }
      if (step.fromRecord) {
        const ban = document.createElement('div');
        ban.className = 'recordBanner';
        ban.innerHTML = '<span class="recordTag">از پرونده</span><span>این موارد از پرونده مادیان بارگذاری شده‌اند و بعداً از پایگاه‌داده خوانده می‌شوند. در صورت نیاز ویرایش کنید.</span>';
        card.appendChild(ban);
      }
      wrap.appendChild(card);

      if (step.kind === 'choice') renderChoice(card, step);
      else if (step.kind === 'scale') renderScale(card, step);
      else if (step.kind === 'multi') renderMulti(card, step);
      else if (step.kind === 'fields') renderFields(card, step);
      else if (step.kind === 'field') renderFields(card, { fields: [step] });
      else if (step.kind === 'textarea') renderFields(card, { fields: [{ key: step.key, type: 'textarea', placeholder: step.placeholder }] });
      else if (step.kind === 'shamsiDate') renderShamsiDate(card, step);
      else if (step.kind === 'size') renderSize(card, step);
      else if (step.kind === 'follicles') renderFollicles(card, step);
      else if (step.kind === 'images') renderImages(card);
      else if (step.kind === 'note') renderNote(card);
      else if (step.kind === 'summary') renderSummary(card);

      const prev = document.getElementById('btnPrev');
      const next = document.getElementById('btnNext');
      prev.disabled = idx <= 0;
      prev.classList.toggle('ghostSlot', idx <= 0);
      const hasChoice = (step.kind === 'choice' || step.kind === 'scale') && choices[step.group];
      const needsNext = hasChoice || ['fields', 'field', 'textarea', 'multi', 'images', 'note', 'size', 'follicles', 'shamsiDate'].includes(step.kind);
      next.classList.toggle('ghostSlot', !needsNext);
      next.disabled = !needsNext;
      next.textContent = 'بعدی';

      document.getElementById('progressBar').style.width = Math.round(((ph.idx + 1) / ph.total) * 100) + '%';
      window.scrollTo({ top: 0 });
    }

    function renderChoice(card, step) {
      const wrap = document.createElement('div');
      wrap.className = 'opts';
      step.options.forEach(o => {
        const { label, cls } = norm(o);
        const b = document.createElement('button');
        b.className = 'opt ' + cls + (choices[step.group] === label ? ' active' : '');
        b.innerHTML = '<span>' + label + '</span><span class="chk">✓</span>';
        b.onclick = () => onChoice(step, label);
        wrap.appendChild(b);
      });
      card.appendChild(wrap);
      if (step.legend) {
        const l = document.createElement('p');
        l.className = 'sub'; l.style.margin = '14px 0 0'; l.style.textAlign = 'center';
        l.innerHTML = step.legend;
        card.appendChild(l);
      }
    }

    function onChoice(step, label) {
      choices[step.group] = label;
      if (step.id === 'bcs') bcs = label;
      if (step.id === 'reason') {
        const r = REASONS.find(x => x.label === label);
        currentReason = r.key;
        document.getElementById('branchName').textContent = r.label;
        delete sizes.rightFollicle;
        delete sizes.leftFollicle;
        delete choices.dominantSide;
        dominantManual = false;
        follicleSide = null;
        if (currentReason === 'ovulation') {
          sizes.rightFollicle = RECORD.prevRightFollicle;
          sizes.leftFollicle = RECORD.prevLeftFollicle;
          choices.dominantSide = RECORD.prevDominantSide;
        }
        currentId = BRANCH_STEPS[currentReason][0].id;
        renderStep();
        return;
      }
      renderStep();
      setTimeout(next, 240);
    }

    function renderScale(card, step) {
      const wrap = document.createElement('div');
      wrap.className = 'scale';
      step.options.forEach(o => {
        const { label } = norm(o);
        const b = document.createElement('button');
        b.textContent = label;
        if (choices[step.group] === label) b.classList.add('active');
        b.onclick = () => onChoice(step, label);
        wrap.appendChild(b);
      });
      card.appendChild(wrap);
    }

    function renderMulti(card, step) {
      const wrap = document.createElement('div');
      wrap.className = 'opts';
      const sel = multis[step.group] || [];
      step.options.forEach(o => {
        const { label, cls } = norm(o);
        const b = document.createElement('button');
        b.className = 'opt ' + cls + (sel.includes(label) ? ' active' : '');
        b.innerHTML = '<span>' + label + '</span><span class="chk">✓</span>';
        b.onclick = () => {
          if (!multis[step.group]) multis[step.group] = [];
          const arr = multis[step.group];
          const i = arr.indexOf(label);
          if (i >= 0) arr.splice(i, 1); else arr.push(label);
          renderStep();
        };
        wrap.appendChild(b);
      });
      card.appendChild(wrap);
    }

    function renderFields(card, step) {
      step.fields.forEach(f => {
        const div = document.createElement('div');
        div.className = 'field';
        const lbl = document.createElement('label'); lbl.textContent = f.label; div.appendChild(lbl);
        if (f.type === 'select') {
          const sel = document.createElement('select');
          sel.dataset.key = f.key;
          const def = document.createElement('option'); def.value = ''; def.textContent = 'انتخاب...'; sel.appendChild(def);
          f.options.forEach(o => { const op = document.createElement('option'); op.textContent = o; sel.appendChild(op); });
          sel.value = fields[f.key] || '';
          sel.onchange = () => { fields[f.key] = sel.value; };
          div.appendChild(sel);
        } else if (f.type === 'textarea') {
          const ta = document.createElement('textarea');
          ta.dataset.key = f.key;
          ta.placeholder = f.placeholder || '';
          ta.value = fields[f.key] || '';
          ta.oninput = () => { fields[f.key] = ta.value; };
          div.appendChild(ta);
        } else {
          const uw = document.createElement('div'); uw.className = 'unitwrap';
          const inp = document.createElement('input');
          inp.type = f.type || 'text';
          inp.dataset.key = f.key;
          inp.placeholder = f.placeholder || '';
          inp.value = fields[f.key] || '';
          if (f.type === 'number') inp.inputMode = 'numeric';
          inp.oninput = () => { fields[f.key] = inp.value; };
          uw.appendChild(inp);
          if (f.unit) { const u = document.createElement('span'); u.className = 'u'; u.textContent = f.unit; uw.appendChild(u); }
          div.appendChild(uw);
        }
        card.appendChild(div);
      });
    }

    /* ================= Shamsi date step ================= */
    function renderShamsiDate(card, step) {
      const key = step.key;
      const today = new Date();
      const tj = g2j(today.getFullYear(), today.getMonth() + 1, today.getDate());
      const ty = tj[0], tm = tj[1], td = tj[2];
      const committed = dates[key];
      let sel = committed ? { jy: committed.jy, jm: committed.jm, jd: committed.jd } : { jy: ty, jm: tm, jd: td };

      const ITEM = 36;
      const Y0 = ty - 10, Y1 = ty + 1;

      const disp = document.createElement('button');
      disp.type = 'button';
      function refreshDisp() {
        const isToday = sel.jy === ty && sel.jm === tm && sel.jd === td;
        disp.className = 'dateField' + (dates[key] ? '' : ' empty');
        disp.innerHTML = '<span class="calIco">📅</span><span>' + fmtJ(sel.jy, sel.jm, sel.jd) +
          (isToday && !dates[key] ? ' <small style="color:#1f6049">(امروز)</small>' : '') + '</span>';
      }
      refreshDisp();
      card.appendChild(disp);

      const calWrap = document.createElement('div');
      calWrap.className = 'calWrap open';
      card.appendChild(calWrap);

      function clampDay() {
        const len = monthLen(sel.jy, sel.jm);
        if (sel.jd > len) sel.jd = len;
      }

      function commit() {
        dates[key] = { jy: sel.jy, jm: sel.jm, jd: sel.jd };
        fields[key] = fmtJ(sel.jy, sel.jm, sel.jd);
        renderStep();
        setTimeout(next, 220);
      }

      function colHTML(kind) {
        let items = [];
        if (kind === 'year') { for (let y = Y0; y <= Y1; y++) items.push({ v: y, t: fa(y) }); }
        else if (kind === 'month') { for (let m = 1; m <= 12; m++) items.push({ v: m, t: MONTHS[m] }); }
        else { const len = monthLen(sel.jy, sel.jm); for (let d = 1; d <= len; d++) items.push({ v: d, t: fa(d) }); }
        return '<div class="iosPad"></div><div class="iosPad"></div>' +
          items.map(it => '<div class="iosItem" data-v="' + it.v + '">' + it.t + '</div>').join('') +
          '<div class="iosPad"></div><div class="iosPad"></div>';
      }

      function markOn(col) {
        const el = calWrap.querySelector('.iosCol[data-col="' + col + '"]');
        if (!el) return;
        const v = col === 'year' ? sel.jy : col === 'month' ? sel.jm : sel.jd;
        el.querySelectorAll('.iosItem').forEach(it => it.classList.toggle('on', String(it.dataset.v) === String(v)));
      }

      function scrollColTo(col, v, smooth) {
        const el = calWrap.querySelector('.iosCol[data-col="' + col + '"]');
        if (!el) return;
        const item = el.querySelector('.iosItem[data-v="' + v + '"]');
        if (!item) return;
        el.scrollTo({ top: item.offsetTop - ITEM * 2, behavior: smooth ? 'smooth' : 'auto' });
        markOn(col);
      }

      function snapAll(smooth) {
        scrollColTo('year', sel.jy, smooth);
        scrollColTo('month', sel.jm, smooth);
        scrollColTo('day', sel.jd, smooth);
      }

      function rebuildDay() {
        clampDay();
        const dayCol = calWrap.querySelector('.iosCol[data-col="day"]');
        if (!dayCol) return;
        dayCol.innerHTML = colHTML('day');
        requestAnimationFrame(() => scrollColTo('day', sel.jd, false));
      }

      function drawMini() {
        const box = calWrap.querySelector('#cal-mini');
        if (!box) return;
        const len = monthLen(sel.jy, sel.jm);
        const off = jWeekday(sel.jy, sel.jm, 1);
        let h = '<div class="calGrid">';
        DOWS.forEach(d => { h += '<span class="dow">' + d + '</span>'; });
        for (let i = 0; i < off; i++) h += '<span></span>';
        for (let d = 1; d <= len; d++) {
          let cls = 'day';
          if (sel.jy === ty && sel.jm === tm && d === td) cls += ' today';
          if (sel.jd === d) cls += ' sel';
          h += '<button type="button" class="' + cls + '" data-day="' + d + '">' + fa(d) + '</button>';
        }
        h += '</div>';
        box.innerHTML = h;
        box.querySelectorAll('.day').forEach(b => {
          b.onclick = () => {
            sel.jd = parseInt(b.dataset.day, 10);
            scrollColTo('day', sel.jd, true);
            drawMini();
            refreshDisp();
          };
        });
      }

      function applyFromWheel(col) {
        const el = calWrap.querySelector('.iosCol[data-col="' + col + '"]');
        const idx = Math.max(0, Math.round(el.scrollTop / ITEM));
        const items = el.querySelectorAll('.iosItem');
        const it = items[Math.min(idx, items.length - 1)];
        if (!it) return;
        const v = parseInt(it.dataset.v, 10);
        if (col === 'year') sel.jy = v;
        else if (col === 'month') sel.jm = v;
        else sel.jd = v;
        if (col !== 'day') rebuildDay();
        markOn(col);
        drawMini();
        refreshDisp();
      }

      function bindWheel(col) {
        const el = calWrap.querySelector('.iosCol[data-col="' + col + '"]');
        let t;
        el.addEventListener('scroll', () => {
          clearTimeout(t);
          const idx = Math.max(0, Math.round(el.scrollTop / ITEM));
          const items = el.querySelectorAll('.iosItem');
          items.forEach((it, i) => it.classList.toggle('on', i === idx));
          t = setTimeout(() => applyFromWheel(col), 80);
        }, { passive: true });
      }

      calWrap.innerHTML =
        '<div class="iosLabs"><span>سال</span><span>ماه</span><span>روز</span></div>' +
        '<div class="iosPicker">' +
          '<div class="iosHi"></div>' +
          '<div class="iosFade iosFadeT"></div>' +
          '<div class="iosFade iosFadeB"></div>' +
          '<div class="iosCol" data-col="year">' + colHTML('year') + '</div>' +
          '<div class="iosCol" data-col="month">' + colHTML('month') + '</div>' +
          '<div class="iosCol" data-col="day">' + colHTML('day') + '</div>' +
        '</div>' +
        '<div id="cal-mini"></div>' +
        '<div class="calFoot">' +
          '<button type="button" class="calToday">امروز</button>' +
          '<button type="button" class="confirmBtn">✓ ثبت این تاریخ</button>' +
        '</div>';

      bindWheel('year'); bindWheel('month'); bindWheel('day');
      calWrap.querySelector('.calToday').onclick = () => {
        sel = { jy: ty, jm: tm, jd: td };
        rebuildDay();
        requestAnimationFrame(() => { snapAll(true); drawMini(); refreshDisp(); });
      };
      calWrap.querySelector('.confirmBtn').onclick = commit;

      requestAnimationFrame(() => {
        snapAll(false);
        drawMini();
      });
    }

    /* ================= size picker (overlay) ================= */
    function popConfig() {
      if (!curFollicle) return { min: 0, max: 70, presets: [10, 20, 30, 40, 50], typical: '' };
      if (anovOn) return Object.assign({}, ANOV_RANGE);
      const breed = choices.breed || 'نامشخص';
      return Object.assign({}, (BREED_RANGE[breed] || BREED_RANGE['نامشخص']));
    }
    function clampVal(v) {
      const c = popConfig();
      return Math.max(c.min, Math.min(c.max, v));
    }

    function buildPopover(host, title, isFollicle) {
      curFollicle = !!isFollicle;
      anovOn = false;
      host.querySelector('.popover')?.remove();
      host.querySelector('.wrapScrim')?.remove();
      const scrim = document.createElement('div');
      scrim.className = 'wrapScrim';
      scrim.onclick = closePopover;
      host.appendChild(scrim);
      const pop = document.createElement('div');
      pop.className = 'popover';
      host.appendChild(pop);
      fillPopover(pop, title);
      return pop;
    }

    function fillPopover(pop, title) {
      const cfg = popConfig();
      const raw = sizes[sheetKey] != null ? sizes[sheetKey] : 0;
      const v = clampVal(raw);
      let h = '<div class="popHead"><span class="lbl">' + title + '</span></div>' +
        '<div class="popValue" id="pop-value">' + fa(v) + ' <small>mm</small></div>' +
        '<div class="stepper">' +
        '<button type="button" class="stepBtn" id="pop-minus">−</button>' +
        '<input type="number" id="num-input" inputmode="numeric" min="' + cfg.min + '" max="' + cfg.max + '" value="' + v + '">' +
        '<button type="button" class="stepBtn" id="pop-plus">+</button>' +
        '<span class="mm">میلی‌متر</span>' +
        '</div>' +
        '<div class="rangeRow"><span class="min">' + fa(cfg.min) + '</span>' +
        '<input type="range" id="pop-range" min="' + cfg.min + '" max="' + cfg.max + '" step="1" value="' + v + '">' +
        '<span class="max">' + fa(cfg.max) + '</span></div>' +
        '<div class="presets">' +
        cfg.presets.map(p => '<button data-v="' + p + '">' + fa(p) + '</button>').join('') +
        '</div>';
      if (curFollicle) {
        h += '<div style="text-align:center;margin-top:10px">' +
          '<button type="button" id="anov-toggle" style="border:1.5px solid ' + (anovOn ? 'var(--red)' : 'var(--line)') +
          ';background:' + (anovOn ? 'var(--red2)' : '#fff') + ';color:' + (anovOn ? 'var(--red)' : '#777') +
          ';border-radius:99px;padding:8px 14px;font-size:12px;font-weight:700">' +
          (anovOn ? '✓ ' : '') + 'فولیکول غیرطبیعی (آنوولاتوری / هموراژیک)' +
          '</button></div>';
      }
      if (cfg.typical) {
        h += '<div style="text-align:center;font-size:11px;color:#b9831d;margin-top:8px;font-weight:700">' + cfg.typical + '</div>';
      }
      h += '<div class="popBtns">' +
        '<button class="clear" id="pop-clear">حذف مقدار</button>' +
        '<button class="ok" id="pop-ok">تأیید ✓</button>' +
        '</div>';
      pop.innerHTML = h;

      const range = pop.querySelector('#pop-range');
      const num = pop.querySelector('#num-input');

      range.addEventListener('input', e => {
        const val = clampVal(parseInt(e.target.value, 10) || 0);
        range.value = val;
        num.value = val;
        onPopSlide(val);
      });
      num.addEventListener('input', () => {
        let val = parseInt(num.value, 10);
        if (isNaN(val)) val = 0;
        val = clampVal(val);
        range.value = val;
        onPopSlide(val);
      });
      num.addEventListener('focus', () => num.select());
      pop.querySelector('#pop-minus').onclick = () => {
        const val = clampVal((parseInt(range.value, 10) || 0) - 1);
        range.value = val; num.value = val; onPopSlide(val);
      };
      pop.querySelector('#pop-plus').onclick = () => {
        const val = clampVal((parseInt(range.value, 10) || 0) + 1);
        range.value = val; num.value = val; onPopSlide(val);
      };
      pop.querySelectorAll('.presets button').forEach(b => b.onclick = () => {
        range.value = b.dataset.v; num.value = b.dataset.v;
        onPopSlide(parseInt(b.dataset.v, 10));
      });
      pop.querySelector('#pop-clear').onclick = clearSize;
      pop.querySelector('#pop-ok').onclick = confirmSize;
      if (curFollicle) {
        pop.querySelector('#anov-toggle').onclick = () => {
          anovOn = !anovOn;
          fillPopover(pop, title);
          const rr = pop.querySelector('#pop-range');
          onPopSlide(parseInt(rr.value, 10) || 0);
        };
      }
    }

    function openPopover() {
      const pop = document.querySelector('.popover');
      if (!pop) return;
      pop.classList.add('open');
      const scrim = pop.parentElement.querySelector('.wrapScrim');
      if (scrim) scrim.classList.add('show');
      const range = document.getElementById('pop-range');
      const v = sizes[sheetKey] != null ? sizes[sheetKey] : 0;
      range.value = clampVal(v);
      const num = document.getElementById('num-input');
      if (num) num.value = range.value;
      onPopSlide(parseInt(range.value, 10) || 0);
    }

    function clearSize() {
      delete sizes[sheetKey];
      const isCombined = sheetKey === 'rightFollicle' || sheetKey === 'leftFollicle';
      closePopover();
      if (isCombined) { renderStep(); toast('حذف شد'); }
      else { renderStep(); }
    }
    function closePopover() {
      document.querySelectorAll('.popover').forEach(p => p.classList.remove('open'));
      document.querySelectorAll('.wrapScrim').forEach(s => s.classList.remove('show'));
    }
    function onPopSlide(v) {
      const pv = document.getElementById('pop-value');
      if (pv) pv.innerHTML = fa(v) + ' <small>mm</small>';
      const num = document.getElementById('num-input');
      if (num && document.activeElement !== num) num.value = v;
      if (sheetKey === 'rightFollicle' || sheetKey === 'leftFollicle') {
        drawFollicleMarker(v);
        syncDominantFromSize();
      } else drawFollicleSVG(v);
    }
    function confirmSize() {
      const v = parseInt(document.getElementById('pop-range').value, 10) || 0;
      if (v > 0) sizes[sheetKey] = v; else delete sizes[sheetKey];
      if ((sheetKey === 'rightFollicle' || sheetKey === 'leftFollicle') && !dominantManual) {
        const auto = autoDominant();
        if (auto) choices.dominantSide = auto;
      }
      closePopover();
      if (sheetKey === 'rightFollicle' || sheetKey === 'leftFollicle') { renderStep(); toast('ثبت شد'); }
      else { renderStep(); setTimeout(next, 200); }
    }

    /* ================= single-size SVG ================= */
    const FSCALE = 1.15;
    function follicleSVG(v) {
      const r = v > 0 ? Math.min(64, Math.max(6, v * FSCALE)) : 0;
      const ref = 10 * FSCALE;
      let foll = '';
      if (r > 0) {
        foll = '<circle cx="130" cy="92" r="' + r + '" fill="url(#follGrad)" stroke="#dfe8f2" stroke-width="3"/>' +
          '<ellipse cx="' + (130 - r * 0.32) + '" cy="' + (92 - r * 0.36) + '" rx="' + (r * 0.22) + '" ry="' + (r * 0.15) + '" fill="#ffffff" opacity="0.28" transform="rotate(-28 ' + (130 - r * 0.32) + ' ' + (92 - r * 0.36) + ')"/>';
        if (r > 20) foll += '<text x="130" y="' + (92 + r * 0.28) + '" font-size="' + Math.min(20, r * 0.62) + '" text-anchor="middle" fill="#ffffff" font-weight="700">' + fa(v) + '</text>';
      }
      return '<svg viewBox="0 0 260 185" xmlns="http://www.w3.org/2000/svg" font-family="Vazirmatn, Tahoma, sans-serif">' +
        '<defs>' +
        '<radialGradient id="follGrad" cx="40%" cy="34%" r="78%"><stop offset="0%" stop-color="#43434a"/><stop offset="100%" stop-color="#121215"/></radialGradient>' +
        '<radialGradient id="ovGrad" cx="35%" cy="30%" r="85%"><stop offset="0%" stop-color="#fbf2ed"/><stop offset="100%" stop-color="#ecd8cf"/></radialGradient>' +
        '</defs>' +
        '<ellipse cx="130" cy="92" rx="102" ry="63" fill="url(#ovGrad)" stroke="#e3c9bd" stroke-width="2.5"/>' +
        '<circle cx="196" cy="52" r="13" fill="url(#follGrad)" stroke="#dfe8f2" stroke-width="2" opacity="0.9"/>' +
        '<circle cx="36" cy="34" r="' + ref + '" fill="none" stroke="#b9c6bf" stroke-width="2" stroke-dasharray="3 3"/>' +
        '<text x="36" y="56" text-anchor="middle" font-size="10" fill="#9aa7a0">۱۰mm</text>' +
        foll + '</svg>';
    }

    function renderSize(card, step) {
      const v = sizes[step.key];
      const box = document.createElement('div');
      box.className = 'follicleWrap';
      box.id = 'foll-svg';
      box.innerHTML = follicleSVG(v);
      box.onclick = () => { sheetKey = step.key; buildPopover(box, step.title, step.key !== 'vesicleSize'); openPopover(); };
      card.appendChild(box);

      const valLbl = document.createElement('div');
      valLbl.className = 'follicleVal';
      valLbl.id = 'foll-label';
      valLbl.innerHTML = v != null ? fa(v) + ' میلی‌متر' : '<span>برای تنظیم، روی تصویر بزنید</span>';
      card.appendChild(valLbl);
    }

    function drawFollicleSVG(v) {
      const svg = document.getElementById('foll-svg');
      if (svg) svg.innerHTML = follicleSVG(v);
      const lbl = document.getElementById('foll-label');
      if (lbl) lbl.innerHTML = v > 0 ? fa(v) + ' میلی‌متر' : '<span>برای تنظیم، روی تصویر بزنید</span>';
    }

    /* ================= combined follicles page ================= */
    function markerHTML(side) {
      const key = side + 'Follicle';
      const v = sizes[key];
      const pos = FOL_POS[side];
      const label = side === 'right' ? 'تخمدان راست' : 'تخمدان چپ';
      const foll = v != null ? '<span class="ffollicle" style="width:' + fpx(v) + 'px;height:' + fpx(v) + 'px">' + fa(v) + '</span>' : '';
      return '<button class="fmarker' + (follicleSide === side ? ' sel' : '') + '" data-side="' + side + '" style="left:' + pos.x + '%;top:' + pos.y + '%">' +
        foll +
        '<span class="fdot"></span>' +
        '<span class="fchip">' + label + (v != null ? ' · ' + fa(v) + 'mm' : '') + '</span>' +
        '</button>';
    }

    function autoDominant() {
      const r = sizes.rightFollicle, l = sizes.leftFollicle;
      if (r != null && l != null) {
        if (r > l) return 'راست';
        if (l > r) return 'چپ';
        return 'مشخص نیست';
      }
      if (r != null) return 'راست';
      if (l != null) return 'چپ';
      return null;
    }

    function syncDominantFromSize() {
      if (!dominantManual) {
        const auto = autoDominant();
        if (auto) choices.dominantSide = auto;
        else delete choices.dominantSide;
      }
      const wrap = document.getElementById('anatomy');
      if (!wrap) return;
      const overlay = wrap.querySelector('.domOverlay');
      if (overlay) {
        overlay.innerHTML = renderDominantHTML();
        bindDomOpts(wrap);
      }
      wrap.querySelectorAll('.fmarker').forEach(m => {
        const isDom = (m.dataset.side === 'right' && choices.dominantSide === 'راست')
          || (m.dataset.side === 'left' && choices.dominantSide === 'چپ');
        m.classList.toggle('dom', !!isDom);
      });
    }

    function renderFollicles(card, step) {
      if (!dominantManual) {
        const auto = autoDominant();
        if (auto) choices.dominantSide = auto;
      }

      const lay = document.createElement('div');
      lay.className = 'folliclesLayout';

      const imgWrap = document.createElement('div');
      imgWrap.className = 'anatomyWrap';
      imgWrap.id = 'anatomy';
      imgWrap.innerHTML = '<img src="' + ANATOMY_IMG + '" alt="آناتومی دستگاه تولیدمثل مادیان">' +
        markerHTML('right') + markerHTML('left') +
        '<div class="domOverlay">' + renderDominantHTML() + '</div>';
      lay.appendChild(imgWrap);
      bindDomOpts(imgWrap);
      card.appendChild(lay);
      attachMarkers(imgWrap);
      syncDominantFromSize();
    }

    function renderDominantHTML() {
      const cur = choices.dominantSide;
      const auto = !dominantManual && cur;
      const opts = ['راست', 'چپ', 'مشخص نیست']
        .map(l => '<button type="button" class="' + (cur === l ? 'active' : '') + '" data-dom="' + l + '">' + l + '</button>')
        .join('');
      return '<div class="domHead">فولیکول غالب' + (auto ? '<span class="autoTag">تعیین خودکار</span>' : '') + '</div>' +
        '<div class="domPills">' + opts + '</div>';
    }

    function bindDomOpts(container) {
      const overlay = container.querySelector('.domOverlay') || container;
      overlay.querySelectorAll('[data-dom]').forEach(b => {
        b.onclick = ev => {
          ev.stopPropagation();
          dominantManual = true;
          choices.dominantSide = b.dataset.dom;
          overlay.innerHTML = renderDominantHTML();
          bindDomOpts(container);
        };
      });
    }



    function attachMarkers(wrap) {
      wrap.querySelectorAll('.fmarker').forEach(b => {
        b.onclick = () => {
          follicleSide = b.dataset.side;
          sheetKey = follicleSide + 'Follicle';
          refreshFollicleMarkers();
          const w = document.getElementById('anatomy');
          buildPopover(w, 'فولیکول ' + (follicleSide === 'right' ? 'راست' : 'چپ'), true);
          openPopover();
        };
      });
    }

    function refreshFollicleMarkers() {
      const wrap = document.getElementById('anatomy');
      if (!wrap) return;
      wrap.querySelectorAll('.fmarker').forEach(el => el.remove());
      const overlay = wrap.querySelector('.domOverlay');
      const html = markerHTML('right') + markerHTML('left');
      if (overlay) overlay.insertAdjacentHTML('beforebegin', html);
      else wrap.insertAdjacentHTML('beforeend', html);
      attachMarkers(wrap);
    }

    function drawFollicleMarker(v) {
      const wrap = document.getElementById('anatomy');
      if (!wrap) return;
      const marker = wrap.querySelector('.fmarker[data-side="' + follicleSide + '"]');
      if (!marker) return;
      const key = follicleSide + 'Follicle';
      if (v > 0) sizes[key] = v; else delete sizes[key];
      const label = follicleSide === 'right' ? 'تخمدان راست' : 'تخمدان چپ';
      let foll = marker.querySelector('.ffollicle');
      if (v > 0) {
        if (!foll) {
          foll = document.createElement('span');
          foll.className = 'ffollicle';
          marker.insertBefore(foll, marker.querySelector('.fdot'));
        }
        foll.style.width = fpx(v) + 'px';
        foll.style.height = fpx(v) + 'px';
        foll.textContent = fa(v);
      } else if (foll) {
        foll.remove();
      }
      const chip = marker.querySelector('.fchip');
      if (chip) chip.textContent = label + (v > 0 ? ' · ' + fa(v) + 'mm' : '');
    }

    function renderImages(card) {
      const up = document.createElement('div'); up.className = 'uploadBox';
      const inp = document.createElement('input');
      inp.type = 'file'; inp.accept = 'image/*'; inp.multiple = true; inp.id = 'upload-main';
      inp.onchange = () => handleImages(inp.files);
      const lbl = document.createElement('label'); lbl.className = 'uploadBtn'; lbl.setAttribute('for', 'upload-main');
      lbl.textContent = '📷 انتخاب عکس‌های سونوگرافی';
      const help = document.createElement('div'); help.className = 'uploadHelp'; help.textContent = 'امکان انتخاب چند عکس هم‌زمان وجود دارد.';
      const count = document.createElement('div'); count.className = 'imageCount'; count.id = 'count-main';
      const grid = document.createElement('div'); grid.className = 'imagePreviewGrid'; grid.id = 'grid-main';
      up.appendChild(inp); up.appendChild(lbl); up.appendChild(help);
      card.appendChild(up);
      card.appendChild(count); card.appendChild(grid);
      refreshImages();
    }
    function refreshImages() {
      const imgs = ultrasoundImages[currentReason] || [];
      const count = document.getElementById('count-main');
      const grid = document.getElementById('grid-main');
      if (!count || !grid) return;
      count.textContent = imgs.length ? fa(imgs.length) + ' عکس اضافه شده است.' : 'هنوز عکسی اضافه نشده است.';
      grid.innerHTML = imgs.map((img, i) =>
        '<div class="imageItem"><img src="' + img.data + '"><button class="imageRemove" type="button" onclick="removeImage(' + i + ')">×</button></div>'
      ).join('');
    }
    function handleImages(fileList) {
      const list = Array.from(fileList || []);
      list.forEach(file => {
        if (!file.type.startsWith('image/')) return;
        const reader = new FileReader();
        reader.onload = e => {
          ultrasoundImages[currentReason].push({ name: file.name, type: file.type, data: e.target.result });
          refreshImages();
        };
        reader.readAsDataURL(file);
      });
      document.getElementById('upload-main').value = '';
    }
    function removeImage(i) {
      ultrasoundImages[currentReason].splice(i, 1);
      refreshImages();
    }

    function renderNote(card) {
      stopVoice();
      const ta = document.createElement('textarea');
      ta.id = 'doctorNote';
      ta.placeholder = 'یادداشت تکمیلی را بنویسید یا دکمه میکروفون را بزنید...';
      ta.value = fields.doctorNote || '';
      ta.oninput = () => { fields.doctorNote = ta.value; };
      card.appendChild(ta);
      const bar = document.createElement('div');
      bar.className = 'voiceBar';
      bar.innerHTML =
        '<button type="button" class="voiceBtn" id="voiceBtn"><span class="micDot"></span>تبدیل صدا به متن</button>' +
        '<span class="voiceHint" id="voiceHint">فارسی • رایگان در مرورگر (Chrome / Edge / Safari)</span>' +
        '<div class="voiceLive" id="voiceLive"></div>';
      card.appendChild(bar);
      document.getElementById('voiceBtn').onclick = voiceInput;
    }

    function renderSummary(card) {
      const pre = document.createElement('div');
      pre.className = 'preview';
      pre.id = 'summaryPreview';
      pre.textContent = getReportText();
      card.appendChild(pre);
      const imgs = ultrasoundImages[currentReason] || [];
      if (imgs.length) {
        const ri = document.createElement('div'); ri.className = 'reportImages';
        ri.innerHTML = '<div class="reportImageGrid" style="margin-bottom:6px">' + imgs.map(img => '<img src="' + img.data + '">').join('') + '</div>';
        card.appendChild(ri);
      }
      const btns = document.createElement('div');
      btns.className = 'summaryBtns';
      const copy = document.createElement('button'); copy.className = 'ghost'; copy.textContent = '📋 کپی متن'; copy.onclick = copyReport;
      const save = document.createElement('button'); save.className = 'ghost'; save.textContent = '💾 ذخیره موقت'; save.onclick = saveDraft;
      const build = document.createElement('button'); build.className = 'ok'; build.textContent = 'ساخت گزارش نهایی ✓'; build.onclick = finalize;
      btns.appendChild(copy); btns.appendChild(save); btns.appendChild(build);
      card.appendChild(btns);
    }

    /* ================= report ================= */
    function reportCycle() {
      return 'نوع ویزیت: بررسی سیکل / زمان تلقیح\nوضعیت سیکل: ' + active('cycleStage') +
        '\nآخرین تلقیح/جفت‌گیری: ' + val('lastBreedingDate') + ' - روش: ' + active('breedingMethod') +
        '\nتخمدان راست: بزرگ‌ترین فولیکول ' + size('rightFollicle') +
        '\nتخمدان چپ: بزرگ‌ترین فولیکول ' + size('leftFollicle') +
        '\nفولیکول غالب: ' + active('dominantSide') +
        '\nCL: ' + active('clCycle') +
        '\nرحم: ادم درجه ' + active('edemaCycle') + '؛ مایع داخل رحم: ' + active('fluidCycle') +
        '\nسرویکس: ' + active('cervixCycle') +
        '\nبرآورد زمان تخمک‌گذاری: ' + active('ovEstimate') +
        '\nاقدام پیشنهادی: ' + active('cycleAction');
    }
    function reportOvulation() {
      let extra = active('ovResult') === 'تخمک‌گذاری انجام شده'
        ? '\nشواهد حمایتی: ' + multi('ovSigns') + '\nسمت تخمک‌گذاری: ' + active('ovSide') : '';
      return 'نوع ویزیت: بررسی تخمک‌گذاری\nآخرین کنترل: ' + val('lastScan') +
        '\nتخمدان راست قبلی: بزرگ‌ترین فولیکول ' + size('rightFollicle') +
        '\nتخمدان چپ قبلی: بزرگ‌ترین فولیکول ' + size('leftFollicle') +
        '\nفولیکول غالب قبلی: ' + active('dominantSide') +
        '\nنتیجه بررسی: ' + active('ovResult') + extra +
        '\nبرنامه بعدی: ' + active('ovAction');
    }
    function reportPregnancy() {
      const s = active('pregStatus');
      let details = '';
      if (s === 'مشاهده شد') {
        details = '\nتعداد وزیکول‌ها: ' + active('vesicleCount') +
          '\nاندازه وزیکول اصلی: ' + size('vesicleSize') +
          '\nمحل: ' + active('pregLocation') +
          '\nEmbryo/Fetal pole: ' + active('embryoStatus');
        if (active('embryoStatus') === 'مشاهده شد') details += '\nضربان قلب: ' + active('heartbeat');
        details += '\nظاهر کلی آبستنی: ' + active('pregAppearance');
      } else if (s !== 'ثبت نشده') {
        details = '\nرحم: ' + active('pregUterus') + '\nCL: ' + active('pregCL');
      }
      return 'نوع ویزیت: بررسی آبستنی\nروز پس از تلقیح/جفت‌گیری: ' + (val('daysPostBreeding') === 'ثبت نشده' ? 'ثبت نشده' : val('daysPostBreeding') + ' روز') +
        '\nتاریخ آخرین تلقیح: ' + val('pregBreedingDate') +
        '\nنتیجه سونوگرافی: ' + s + details +
        '\nبرنامه پیگیری: ' + active('pregAction');
    }
    function reportProblem() {
      return 'نوع ویزیت: بررسی مشکل تولیدمثلی\nعلت اصلی: ' + active('problemReason') +
        '\nتاریخچه: ' + val('problemHistory') +
        '\nیافته‌های رحم: ' + multi('uterusProblem') +
        '\nیافته‌های تخمدان: ' + multi('ovaryProblem') +
        '\nسرویکس: ' + active('problemCervix') +
        '\nAssessment: ' + val('problemAssessment') +
        '\nاقدامات پیشنهادی: ' + multi('problemAction');
    }
    function reportOther() {
      return 'نوع ویزیت: سایر\nعلت مراجعه: ' + val('otherReason') +
        '\nیافته‌ها: ' + val('otherFindings') +
        '\nنتیجه / توصیه: ' + val('otherPlan');
    }

    function getReportText() {
      let txt = currentReason === 'cycle' ? reportCycle() :
        currentReason === 'ovulation' ? reportOvulation() :
        currentReason === 'pregnancy' ? reportPregnancy() :
        currentReason === 'problem' ? reportProblem() : reportOther();
      txt = 'BCS مادیان: ' + (bcs ? (bcs === 'ارزیابی نشد' ? 'ارزیابی نشد' : bcs + ' / 9') : 'ثبت نشده') + '\n' + txt;
      const note = fields.doctorNote || '';
      if (note.trim()) txt += '\nیادداشت تکمیلی دامپزشک: ' + note.trim();
      const n = (ultrasoundImages[currentReason] || []).length;
      if (n) txt += '\nتعداد تصاویر سونوگرافی ضمیمه: ' + n;
      return txt;
    }

    /* ================= nav ================= */
    function next() {
      const vis = visibleSteps();
      const i = vis.findIndex(s => s.id === currentId);
      if (i >= 0 && i < vis.length - 1) { currentId = vis[i + 1].id; renderStep(); }
      else if (i === vis.length - 1 && currentId === 'summary') { finalize(); }
    }
    function prev() {
      const vis = visibleSteps();
      const i = vis.findIndex(s => s.id === currentId);
      if (i > 0) { currentId = vis[i - 1].id; renderStep(); }
    }

    function seedFromRecord() {
      currentReason = null;
      currentId = 'bcs';
      follicleSide = null;
      anovOn = false;
      curFollicle = false;
      dominantManual = false;
      sheetKey = null;
      bcs = null;
      Object.keys(choices).forEach(k => delete choices[k]);
      choices.breedingMethod = RECORD.breedingMethod;
      Object.keys(multis).forEach(k => delete multis[k]);
      Object.keys(fields).forEach(k => delete fields[k]);
      Object.assign(fields, {
        lastScan: RECORD.lastScan,
        lastBreedingDate: RECORD.lastBreedingDate,
        pregBreedingDate: RECORD.lastBreedingDate,
        daysPostBreeding: RECORD.daysPostBreeding,
        prevMethod: RECORD.prevMethod,
        prevFollicleNote: RECORD.prevFollicleNote,
        problemHistory: RECORD.problemHistory
      });
      Object.keys(sizes).forEach(k => delete sizes[k]);
      Object.keys(dates).forEach(k => delete dates[k]);
      Object.assign(dates, {
        lastBreedingDate: Object.assign({}, RECORD.lastBreeding),
        pregBreedingDate: Object.assign({}, RECORD.lastBreeding)
      });
      Object.keys(ultrasoundImages).forEach(k => { ultrasoundImages[k] = []; });
      const bn = document.getElementById('branchName');
      if (bn) bn.textContent = 'فرم تطبیقی سونوگرافی مادیان';
    }

    function resetForm() {
      stopVoice();
      seedFromRecord();
      renderStep();
      toast('فرم از ابتدا شروع شد');
    }
    function finalize() {
      const p = document.getElementById('summaryPreview');
      if (p) p.textContent = getReportText();
      document.getElementById('progressBar').style.width = '100%';
      toast('گزارش نهایی ساخته شد');
    }
    function copyReport() {
      const t = getReportText();
      const done = () => toast('متن گزارش کپی شد');
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(t).then(done).catch(() => fallbackCopy());
      } else fallbackCopy();
    }
    function fallbackCopy() {
      const ta = document.createElement('textarea');
      ta.value = getReportText();
      ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      document.execCommand('copy'); ta.remove();
      toast('متن گزارش کپی شد');
    }
    function saveDraft() {
      try {
        const state = { reason: currentReason, bcs, choices, multis, fields, sizes, dates, images: ultrasoundImages, time: new Date().toISOString() };
        localStorage.setItem('equibook_onehand_v4', JSON.stringify(state));
        toast('فرم موقتاً روی این دستگاه ذخیره شد');
      } catch (e) {
        toast('حجم تصاویر زیاد است؛ گزارش را نهایی کنید');
      }
    }

    /* ================= voice (Web Speech API, fa-IR) ================= */
    let rec = null;
    let recOn = false;

    function stopVoice() {
      if (rec) {
        try { rec.onend = null; rec.stop(); } catch (e) {}
      }
      rec = null;
      recOn = false;
      const btn = document.getElementById('voiceBtn');
      const hint = document.getElementById('voiceHint');
      const live = document.getElementById('voiceLive');
      if (btn) btn.classList.remove('recording');
      if (hint) hint.textContent = 'فارسی • رایگان در مرورگر (Chrome / Edge / Safari)';
      if (live) { live.classList.remove('show'); live.textContent = ''; }
    }

    function voiceInput() {
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SR) {
        toast('این مرورگر تشخیص گفتار را پشتیبانی نمی‌کند');
        return;
      }
      if (recOn) { stopVoice(); toast('ضبط متوقف شد'); return; }

      const ta = document.getElementById('doctorNote');
      const btn = document.getElementById('voiceBtn');
      const hint = document.getElementById('voiceHint');
      const live = document.getElementById('voiceLive');
      if (!ta) return;

      rec = new SR();
      rec.lang = 'fa-IR';
      rec.interimResults = true;
      rec.continuous = true;
      rec.maxAlternatives = 1;

      const base = ta.value;
      let finals = '';

      rec.onstart = () => {
        recOn = true;
        if (btn) btn.classList.add('recording');
        if (hint) hint.textContent = 'در حال شنیدن فارسی… دوباره بزنید برای توقف';
      };
      rec.onresult = e => {
        let interim = '';
        for (let i = e.resultIndex; i < e.results.length; i++) {
          const t = e.results[i][0].transcript.trim();
          if (!t) continue;
          if (e.results[i].isFinal) finals += (finals ? ' ' : '') + t;
          else interim += (interim ? ' ' : '') + t;
        }
        const extra = [finals, interim].filter(Boolean).join(' ');
        ta.value = [base.replace(/\s+$/, ''), extra].filter(Boolean).join(base.trim() ? ' ' : '');
        fields.doctorNote = ta.value;
        if (live) {
          if (interim) { live.textContent = interim; live.classList.add('show'); }
          else { live.classList.remove('show'); live.textContent = ''; }
        }
      };
      rec.onerror = e => {
        if (e.error === 'not-allowed' || e.error === 'service-not-allowed') toast('دسترسی میکروفون داده نشد');
        else if (e.error === 'no-speech') toast('صدایی شنیده نشد');
        else if (e.error === 'audio-capture') toast('میکروفون پیدا نشد');
        else if (e.error !== 'aborted') toast('خطای تشخیص گفتار');
      };
      rec.onend = () => {
        const wasOn = recOn;
        recOn = false;
        rec = null;
        if (btn) btn.classList.remove('recording');
        if (hint) hint.textContent = 'فارسی • رایگان در مرورگر (Chrome / Edge / Safari)';
        if (live) { live.classList.remove('show'); live.textContent = ''; }
        if (wasOn && finals) toast('متن صوتی اضافه شد');
      };
      try { rec.start(); }
      catch (err) { toast('شروع ضبط ممکن نشد'); stopVoice(); }
    }

    /* ================= init ================= */
    renderStep();
  </script>
</body>
</html>