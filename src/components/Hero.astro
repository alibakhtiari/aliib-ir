---
import { getDictionary, isRtlLocale } from '../i18n/utils';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const dict = getDictionary(locale);
const isRtl = isRtlLocale(locale);

const skillsList = dict.hero.skills.list;
---

<section
  id="home"
  class="hero-section relative overflow-hidden text-start min-h-screen flex items-center justify-center pt-20"
>
  <!-- Abstract Modern Background with Masked Grid -->
  <div class="absolute inset-0 bg-white dark:bg-[#080b13] flex items-center justify-center pointer-events-none">
    <!-- Radial Gradient Background -->
    <div
      class="absolute inset-0 pointer-events-none opacity-60 dark:opacity-30"
      style="background-image: radial-gradient(circle at center, #FFF991 0%, transparent 70%); mix-blend-mode: multiply;"
    ></div>
    <!-- Faded edges Grid Mask -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="mask-image: radial-gradient(ellipse at center, black, transparent 70%); -webkit-mask-image: radial-gradient(ellipse at center, black, transparent 70%);"
    >
      <div class="absolute inset-0 opacity-[0.05] dark:opacity-[0.07]">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
          <defs>
            <pattern id="minimal-grid" width="4" height="4" patternUnits="userSpaceOnUse">
              <path d="M 4 0 L 0 0 0 4" fill="none" stroke="currentColor" stroke-width="0.15"></path>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#minimal-grid)"></rect>
        </svg>
      </div>
    </div>
  </div>

  <div class="container relative z-10 px-4 pt-20 pb-16 mx-auto md:pt-28 md:pb-24">
    <div class="grid items-center w-full grid-cols-1 gap-12 lg:grid-cols-12">
      <!-- Hero Content - Left Column (7 cols on large screens) -->
      <div class="animate-fadeIn lg:col-span-7">
        <div class="inline-block px-3.5 py-1 mb-4 text-xs font-semibold text-blue-700 bg-blue-100/80 rounded-full dark:bg-blue-900/40 dark:text-blue-400 capitalize tracking-wider backdrop-blur-sm">
          {dict.hero.greeting}
        </div>
        <h1 class="mb-2 text-4xl font-extrabold tracking-tight text-gray-900 md:text-5xl lg:text-6xl dark:text-white">
          {dict.hero.name}
        </h1>
        <h2 class="mb-4 text-xl font-medium tracking-tight text-gray-600 md:text-2xl dark:text-gray-300">
          {dict.hero.title}
        </h2>
        <p class="max-w-2xl mb-6 text-base leading-relaxed text-gray-600 dark:text-gray-400">
          {dict.hero.description}
        </p>

        <!-- Professional Bio Quote -->
        <div class="max-w-xl mb-8 border-l-2 border-slate-200 dark:border-slate-800 pl-4 rtl:border-l-0 rtl:border-r-2 rtl:pl-0 rtl:pr-4">
          <p class="text-sm italic leading-relaxed text-gray-500 dark:text-gray-400">
            "{dict.hero.aboutDescription}"
          </p>
        </div>

        <!-- Stats -->
        <div class="flex flex-wrap gap-8 mb-8">
          <div class="flex flex-col group">
            <div class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">12+</div>
            <div class="text-[10px] font-semibold text-gray-500 uppercase tracking-widest mt-1">{dict.hero.stats.experience}</div>
          </div>
          <div class="flex flex-col group">
            <div class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">150+</div>
            <div class="text-[10px] font-semibold text-gray-500 uppercase tracking-widest mt-1">{dict.hero.stats.projects}</div>
          </div>
          <div class="flex flex-col group">
            <div class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">60+</div>
            <div class="text-[10px] font-semibold text-gray-500 uppercase tracking-widest mt-1">{dict.hero.stats.clients}</div>
          </div>
        </div>

        <!-- Skills Pills -->
        <div class="mb-8">
          <div class="w-full flex flex-wrap gap-2 md:max-w-[85%]">
            {skillsList.map((skill: string) => (
              <span class="px-3 py-1.5 text-xs font-medium text-gray-600 transition-colors bg-white/70 border border-gray-200/80 rounded-full dark:bg-gray-800/50 dark:border-gray-700/60 dark:text-gray-300 backdrop-blur-md hover:bg-gray-100 dark:hover:bg-gray-700/60">
                {skill}
              </span>
            ))}
          </div>
        </div>

        <!-- Contact CTA Button -->
        <div class="flex flex-wrap gap-4">
          <a
            href="#contact"
            class="group flex items-center px-7 py-3.5 text-sm font-semibold text-white transition-all bg-gray-900 rounded-full shadow-lg dark:bg-white dark:text-gray-900 hover:scale-105 active:scale-95 hover:shadow-xl"
          >
            <span>{dict.cta.contactMe}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class={`w-5 h-5 ms-2 transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1 ${isRtl ? 'rotate-180' : ''}`}
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z"
                clip-rule="evenodd"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Hero Image - Right Column (5 cols on large screens) -->
      <div class="animate-fadeInRight hidden lg:block lg:col-span-5">
        <div class="relative">
          <div class="relative w-full max-w-md mx-auto aspect-[4/5] perspective-1000">
            <div class="relative w-full h-full overflow-hidden transition-transform duration-500 shadow-2xl rounded-2xl hover:rotate-y-6">
              <img
                src="/Ali Bakhtiari.webp"
                alt={dict.hero.name}
                loading="eager"
                width="400"
                height="500"
                class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
              />
              <div class="absolute inset-0 bg-linear-to-t from-gray-900/40 to-transparent pointer-events-none"></div>
            </div>
          </div>

          <!-- Floating Badge: SEO Expert -->
          <div class="absolute px-5 py-3 bg-white/90 rounded-2xl shadow-xl -left-10 top-1/4 dark:bg-gray-800/90 backdrop-blur-md animate-float border border-gray-100 dark:border-gray-700">
            <div class="flex items-center space-x-3 rtl:space-x-reverse">
              <div class="flex items-center justify-center w-8 h-8 bg-green-100 rounded-lg dark:bg-green-900/30">
                <svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <span class="font-bold text-gray-800 dark:text-gray-200 text-sm">{dict.hero.badges.seoExpert}</span>
            </div>
          </div>

          <!-- Floating Badge: Web Developer -->
          <div class="absolute px-5 py-3 delay-150 bg-white/90 rounded-2xl shadow-xl -right-6 top-2/3 dark:bg-gray-800/90 backdrop-blur-md animate-float border border-gray-100 dark:border-gray-700">
            <div class="flex items-center space-x-3 rtl:space-x-reverse">
              <div class="flex items-center justify-center w-8 h-8 bg-blue-100 rounded-lg dark:bg-blue-900/30">
                <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              </div>
              <span class="font-bold text-gray-800 dark:text-gray-200 text-sm">{dict.hero.badges.webDeveloper}</span>
            </div>
          </div>

          <!-- Floating Badge: Content Writer -->
          <div class="absolute px-5 py-3 delay-300 bg-white/90 rounded-2xl shadow-xl left-1/4 -bottom-6 dark:bg-gray-800/90 backdrop-blur-md animate-float border border-gray-100 dark:border-gray-700">
            <div class="flex items-center space-x-3 rtl:space-x-reverse">
              <div class="flex items-center justify-center w-8 h-8 bg-purple-100 rounded-lg dark:bg-purple-900/30">
                <svg class="w-5 h-5 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
              </div>
              <span class="font-bold text-gray-800 dark:text-gray-200 text-sm">{dict.hero.badges.contentWriter}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Elegant Wave divider -->
  <div class="absolute bottom-0 left-0 right-0 text-white dark:text-gray-900 pointer-events-none">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
      <path
        fill="currentColor"
        fill-opacity="1"
        d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"
      ></path>
    </svg>
  </div>
</section>
